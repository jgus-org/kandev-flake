new file mode 100644
index 0000000..c019ec6
--- /dev/null
+++ b/apps/backend/internal/task/handlers/task_create_initial_model.go
@@ -0,0 +1,44 @@
+package handlers
+
+import (
+	"errors"
+	"strings"
+
+	"github.com/kandev/kandev/internal/task/models"
+)
+
+var errInitialRuntimeRequiresProfile = errors.New("agent_profile_id is required to set initial_model or initial_config_options")
+
+// withInitialSessionRuntime converts the public task-create fields into the
+// existing first-session launch seed. Reserved metadata is always replaced by
+// server-owned values so callers cannot bind a seed to another profile.
+func withInitialSessionRuntime(metadata map[string]interface{}, agentProfileID, initialModel string, initialConfigOptions map[string]string) (map[string]interface{}, error) {
+	if metadata != nil {
+		delete(metadata, models.MetaKeyInitialSessionRuntimeConfig)
+		delete(metadata, models.MetaKeyInitialSessionRuntimeConfigProfileID)
+	}
+	seed := models.SessionRuntimeConfig{Model: strings.TrimSpace(initialModel)}
+	for key, value := range initialConfigOptions {
+		key = strings.TrimSpace(key)
+		value = strings.TrimSpace(value)
+		if key == "" || value == "" {
+			continue
+		}
+		if seed.ConfigOptions == nil {
+			seed.ConfigOptions = make(map[string]string, len(initialConfigOptions))
+		}
+		seed.ConfigOptions[key] = value
+	}
+	if seed.Model == "" && len(seed.ConfigOptions) == 0 {
+		return metadata, nil
+	}
+	if strings.TrimSpace(agentProfileID) == "" {
+		return nil, errInitialRuntimeRequiresProfile
+	}
+	if metadata == nil {
+		metadata = make(map[string]interface{})
+	}
+	metadata[models.MetaKeyInitialSessionRuntimeConfig] = seed
+	metadata[models.MetaKeyInitialSessionRuntimeConfigProfileID] = agentProfileID
+	return metadata, nil
+}
diff --git a/apps/backend/internal/task/handlers/task_create_initial_model_test.go b/apps/backend/internal/task/handlers/task_create_initial_model_test.go
new file mode 100644
index 0000000..2bd549c
--- /dev/null
+++ b/apps/backend/internal/task/handlers/task_create_initial_model_test.go
@@ -0,0 +1,82 @@
+package handlers
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/kandev/kandev/internal/task/models"
+)
+
+func TestWithInitialSessionRuntimeSeedsSelectedProfile(t *testing.T) {
+	metadata, err := withInitialSessionRuntime(map[string]interface{}{"kept": true}, "profile-1", "  model-2  ", nil)
+	if err != nil {
+		t.Fatalf("withInitialSessionRuntime: %v", err)
+	}
+	config, ok := models.LoadInitialSessionRuntimeConfig(metadata)
+	if !ok || config.Model != "model-2" {
+		t.Fatalf("initial runtime config = %#v, %v; want model-2", config, ok)
+	}
+	if got := models.LoadInitialSessionRuntimeConfigProfileID(metadata); got != "profile-1" {
+		t.Fatalf("initial runtime config profile = %q; want profile-1", got)
+	}
+	if metadata["kept"] != true {
+		t.Fatal("unrelated metadata was removed")
+	}
+}
+
+func TestWithInitialSessionRuntimeSeedsConfigOptions(t *testing.T) {
+	metadata, err := withInitialSessionRuntime(nil, "profile-1", "", map[string]string{
+		"reasoning_effort": "high",
+		" empty ":          "   ",
+		"":                 "value",
+	})
+	if err != nil {
+		t.Fatalf("withInitialSessionRuntime: %v", err)
+	}
+	config, ok := models.LoadInitialSessionRuntimeConfig(metadata)
+	if !ok || config.Model != "" {
+		t.Fatalf("initial runtime config = %#v, %v; want empty model", config, ok)
+	}
+	if config.ConfigOptions["reasoning_effort"] != "high" || len(config.ConfigOptions) != 1 {
+		t.Fatalf("initial config options = %#v; want only reasoning_effort=high", config.ConfigOptions)
+	}
+}
+
+func TestWithInitialSessionRuntimeCombinesModelAndConfigOptions(t *testing.T) {
+	metadata, err := withInitialSessionRuntime(nil, "profile-1", "model-2", map[string]string{"reasoning_effort": "low"})
+	if err != nil {
+		t.Fatalf("withInitialSessionRuntime: %v", err)
+	}
+	config, ok := models.LoadInitialSessionRuntimeConfig(metadata)
+	if !ok || config.Model != "model-2" || config.ConfigOptions["reasoning_effort"] != "low" {
+		t.Fatalf("initial runtime config = %#v, %v; want model-2 with reasoning_effort=low", config, ok)
+	}
+}
+
+func TestWithInitialSessionRuntimeStripsClientOwnedSeed(t *testing.T) {
+	metadata := map[string]interface{}{
+		models.MetaKeyInitialSessionRuntimeConfig:          models.SessionRuntimeConfig{Model: "spoofed"},
+		models.MetaKeyInitialSessionRuntimeConfigProfileID: "other-profile",
+	}
+	metadata, err := withInitialSessionRuntime(metadata, "profile-1", "", nil)
+	if err != nil {
+		t.Fatalf("withInitialSessionRuntime: %v", err)
+	}
+	if _, ok := models.LoadInitialSessionRuntimeConfig(metadata); ok {
+		t.Fatal("client-owned initial runtime config was retained")
+	}
+	if got := models.LoadInitialSessionRuntimeConfigProfileID(metadata); got != "" {
+		t.Fatalf("client-owned initial runtime config profile = %q; want empty", got)
+	}
+}
+
+func TestWithInitialSessionRuntimeRequiresProfile(t *testing.T) {
+	_, err := withInitialSessionRuntime(nil, "", "model-2", nil)
+	if !errors.Is(err, errInitialRuntimeRequiresProfile) {
+		t.Fatalf("withInitialSessionRuntime error = %v; want %v", err, errInitialRuntimeRequiresProfile)
+	}
+	_, err = withInitialSessionRuntime(nil, "", "", map[string]string{"reasoning_effort": "high"})
+	if !errors.Is(err, errInitialRuntimeRequiresProfile) {
+		t.Fatalf("withInitialSessionRuntime error = %v; want %v", err, errInitialRuntimeRequiresProfile)
+	}
+}
