+++ b/apps/backend/internal/orchestrator/kandev_initial_input.go
@@ -0,0 +1,30 @@
+package orchestrator
+
+import (
+	"context"
+	"fmt"
+
+	inputmeta "github.com/kandev/kandev/pkg/agent"
+)
+
+func (s *Service) withInitialTaskInput(ctx context.Context, taskID, sessionID string, metadata map[string]interface{}, prompt string) (context.Context, error) {
+	if _, bound := inputmeta.InputFromContext(ctx); bound {
+		return ctx, nil
+	}
+	input, ok := inputmeta.InputFromMetadata(metadata, inputmeta.InitialInputMetadataKey)
+	if !ok || input.Context != prompt {
+		return ctx, nil
+	}
+	sessions, err := s.repo.ListTaskSessions(ctx, taskID)
+	if err != nil {
+		return ctx, fmt.Errorf("list task sessions for initial input: %w", err)
+	}
+	if sessionID == "" {
+		if len(sessions) != 0 {
+			return ctx, nil
+		}
+	} else if len(sessions) != 1 || sessions[0].ID != sessionID {
+		return ctx, nil
+	}
+	return inputmeta.WithInput(ctx, input), nil
+}
diff --git a/apps/backend/internal/orchestrator/kandev_intake.go b/apps/backend/internal/orchestrator/kandev_intake.go
new file mode 100644
index 0000000..d9a752c
--- /dev/null
+++ b/apps/backend/internal/orchestrator/kandev_intake.go
@@ -0,0 +1,141 @@
+package orchestrator
+
+import (
+	"context"
+	"errors"
+	"maps"
+
+	"github.com/google/uuid"
+
+	"github.com/kandev/kandev/internal/orchestrator/messagequeue"
+	inputmeta "github.com/kandev/kandev/pkg/agent"
+	v1 "github.com/kandev/kandev/pkg/api/v1"
+	"go.uber.org/zap"
+)
+
+const nativeIntakePreparedKey = "kandev_intake_prepared"
+const nativeIntakeStrictOwnerKey = "kandev_intake_strict_owner"
+
+func (s *Service) freezeKandevIntake(ctx context.Context, entry *messagequeue.QueuedMessage, input inputmeta.Input) error {
+	return s.messageQueue.UpdateMessageWithMetadata(ctx, entry.SessionID, entry.ID, entry.Content, entry.Attachments, map[string]interface{}{inputmeta.QueuedInputMetadataKey: input, nativeIntakePreparedKey: true}, entry.QueuedBy)
+}
+
+func (s *Service) pendingKandevIntake(ctx context.Context, sessionID string) (*messagequeue.QueuedMessage, inputmeta.Input, error) {
+	if s.messageQueue != nil {
+		entries, _, err := s.messageQueue.SnapshotSession(ctx, sessionID)
+		if err != nil {
+			return nil, inputmeta.Input{}, err
+		}
+		for _, entry := range entries {
+			if input, ok := inputmeta.InputFromMetadata(entry.Metadata, inputmeta.QueuedInputMetadataKey); ok && input.Steer && input.TurnID != "" {
+				return &entry, input, nil
+			}
+		}
+	}
+	return nil, inputmeta.Input{}, nil
+}
+
+func (s *Service) settleKandevIntake(ctx context.Context, entry *messagequeue.QueuedMessage, input inputmeta.Input, dispatchErr error) (err error) {
+	defer func() {
+		if err != nil && !s.isCancelInFlight(entry.SessionID) {
+			attempt := s.nextTransientAttempt(entry.SessionID)
+			s.scheduleTransientRetry(entry.TaskID, entry.SessionID, "", attempt, transientRetryDelay(attempt))
+		}
+	}()
+	if dispatchErr == nil {
+		strict, _ := entry.Metadata[nativeIntakeStrictOwnerKey].(bool)
+		if strict {
+			if err := s.recordStrictKandevIntake(ctx, entry, input); err != nil {
+				return err
+			}
+		}
+		if strict {
+			if err := s.messageQueue.SettleStrictNativeIntake(ctx, entry.SessionID, entry.ID, input); err != nil {
+				return err
+			}
+		} else if err := s.messageQueue.RemoveEntry(ctx, entry.SessionID, entry.ID); err != nil {
+			return err
+		}
+	} else if errors.Is(dispatchErr, inputmeta.ErrTurnClosed) {
+		if strict, _ := entry.Metadata[nativeIntakeStrictOwnerKey].(bool); strict {
+			if err := s.messageQueue.SettleStrictNativeIntake(ctx, entry.SessionID, entry.ID, input); err != nil {
+				return err
+			}
+			s.publishQueueStatusEvent(ctx, entry.SessionID)
+			return nil
+		}
+		input.TurnID, input.Steer, input.Context = "", false, entry.Content
+		if err := s.messageQueue.UpdateMessageWithMetadata(ctx, entry.SessionID, entry.ID, entry.Content, entry.Attachments, map[string]interface{}{inputmeta.QueuedInputMetadataKey: input}, entry.QueuedBy); err != nil {
+			return err
+		}
+	} else {
+		return dispatchErr
+	}
+	s.publishQueueStatusEvent(ctx, entry.SessionID)
+	return nil
+}
+
+func (s *Service) recordStrictKandevIntake(ctx context.Context, entry *messagequeue.QueuedMessage, input inputmeta.Input) error {
+	recorder, ok := s.messageCreator.(interface {
+		CreateUserMessageIdempotent(context.Context, string, string, string, string, string, map[string]interface{}) error
+	})
+	if !ok {
+		return errors.New("idempotent native intake publication is unavailable")
+	}
+	metadata := maps.Clone(entry.Metadata)
+	delete(metadata, inputmeta.QueuedInputMetadataKey)
+	delete(metadata, nativeIntakePreparedKey)
+	delete(metadata, nativeIntakeStrictOwnerKey)
+	delete(metadata, metaKeyUserMessageRecorded)
+	metadata["kandev_input_event_id"] = input.EventID
+	messageID := uuid.NewSHA1(uuid.NameSpaceOID, []byte("kandev-steer:"+input.EventID)).String()
+	return recorder.CreateUserMessageIdempotent(ctx, messageID, entry.TaskID, entry.Content, entry.SessionID, input.TurnID, metadata)
+}
+
+func (s *Service) resolveKandevIntake(ctx context.Context, sessionID string) bool {
+	entry, input, readErr := s.pendingKandevIntake(ctx, sessionID)
+	if readErr != nil {
+		s.logger.Error("native input queue is unavailable", zap.String("session_id", sessionID), zap.Error(readErr))
+		return true
+	}
+	if entry == nil {
+		return false
+	}
+	if s.isCancelInFlight(sessionID) {
+		return true
+	}
+	if _, loaded := s.steerInFlight.LoadOrStore(sessionID, struct{}{}); loaded {
+		return true
+	}
+	defer s.steerInFlight.Delete(sessionID)
+	if prepared, _ := entry.Metadata[nativeIntakePreparedKey].(bool); !prepared {
+		if err := s.freezeKandevIntake(ctx, entry, input); err != nil {
+			return true
+		}
+	}
+	_, err := s.executor.SteerWithDispatchCallback(inputmeta.WithInput(ctx, input), entry.TaskID, sessionID, input.Context, nil, true, func() {})
+	if err := s.settleKandevIntake(ctx, entry, input, err); err != nil {
+		s.logger.Warn("native input delivery remains unresolved", zap.String("session_id", sessionID), zap.String("input_id", input.EventID), zap.Error(err))
+		return true
+	}
+	return false
+}
+
+func (s *Service) persistKandevIntake(ctx context.Context, taskID, sessionID, prompt, model string, planMode bool, attachments []v1.MessageAttachment, input inputmeta.Input, prepared bool) (*messagequeue.QueuedMessage, error) {
+	return s.persistKandevIntakeWithOwner(ctx, taskID, sessionID, prompt, model, planMode, attachments, input, prepared, false, nil)
+}
+
+func (s *Service) persistKandevIntakeWithOwner(ctx context.Context, taskID, sessionID, prompt, model string, planMode bool, attachments []v1.MessageAttachment, input inputmeta.Input, prepared, strictOwner bool, senderMetadata map[string]interface{}) (*messagequeue.QueuedMessage, error) {
+	metadata := maps.Clone(senderMetadata)
+	if metadata == nil {
+		metadata = make(map[string]interface{})
+	}
+	metadata[metaKeyUserMessageRecorded] = true
+	metadata[nativeIntakePreparedKey] = prepared
+	metadata[nativeIntakeStrictOwnerKey] = strictOwner
+	entry, err := s.messageQueue.QueueMessageWithMetadata(inputmeta.WithInput(ctx, input), sessionID, taskID, prompt, model, messagequeue.QueuedByUser, planMode, toQueuedAttachments(attachments), metadata)
+	if err == nil {
+		s.publishQueueStatusEvent(ctx, sessionID)
+	}
+	return entry, err
+}
diff --git a/apps/backend/internal/orchestrator/kandev_recovery.go b/apps/backend/internal/orchestrator/kandev_recovery.go
new file mode 100644
index 0000000..ffc50ba
--- /dev/null
+++ b/apps/backend/internal/orchestrator/kandev_recovery.go
@@ -0,0 +1,100 @@
+package orchestrator
+
+import (
+	"context"
+	"errors"
+
+	"github.com/kandev/kandev/internal/orchestrator/executor"
+	"github.com/kandev/kandev/internal/orchestrator/messagequeue"
+	"github.com/kandev/kandev/internal/orchestrator/watcher"
+	"github.com/kandev/kandev/internal/task/models"
+	inputmeta "github.com/kandev/kandev/pkg/agent"
+	"go.uber.org/zap"
+)
+
+func (s *Service) hasNativeTurnProtocol(ctx context.Context, session *models.TaskSession) bool {
+	return s.nativeTurnProtocol(ctx, session) != ""
+}
+
+func (s *Service) nativeTurnProtocol(ctx context.Context, session *models.TaskSession) string {
+	if session == nil {
+		return ""
+	}
+	if protocol, present := session.AgentProfileSnapshot["native_turn_protocol"]; present {
+		return models.StringFromAny(protocol)
+	}
+	if s.agentManager == nil {
+		return ""
+	}
+	profile, err := s.agentManager.ResolveAgentProfile(ctx, session.AgentProfileID)
+	if err != nil || profile == nil {
+		return ""
+	}
+	return profile.NativeTurnProtocol
+}
+
+func (s *Service) QueueBlockReason(ctx context.Context, sessionID string, status *messagequeue.QueueStatus) string {
+	if status == nil || len(status.Entries) == 0 || messagequeue.QueuedPartCount(&status.Entries[0]) < 2 {
+		return ""
+	}
+	session, err := s.repo.GetTaskSession(ctx, sessionID)
+	if err != nil || session == nil {
+		return ""
+	}
+	if s.nativeTurnProtocol(ctx, session) == inputmeta.NativeTurnProtocolV1 {
+		return "native_input_batch_unsupported"
+	}
+	return ""
+}
+
+func (s *Service) retryUnexpectedKandevExit(ctx context.Context, data watcher.AgentEventData) bool {
+	session, err := s.repo.GetTaskSession(ctx, data.SessionID)
+	if err != nil || session == nil || session.State != models.TaskSessionStateRunning || !s.hasNativeTurnProtocol(ctx, session) || s.isCancelInFlight(data.SessionID) {
+		return false
+	}
+	running, err := s.repo.GetExecutorRunningBySessionID(ctx, session.ID)
+	if err != nil || running == nil || running.ResumeToken == "" {
+		return false
+	}
+	attempt := s.nextTransientAttempt(session.ID)
+	s.scheduleTransientRetry(data.TaskID, session.ID, data.AgentExecutionID, attempt, transientRetryDelay(attempt))
+	return true
+}
+
+func (s *Service) resumeKandevSessionsOnStartup(ctx context.Context) {
+	lister, ok := s.repo.(interface {
+		ListActiveTaskSessions(context.Context) ([]*models.TaskSession, error)
+	})
+	if !ok {
+		return
+	}
+	sessions, err := lister.ListActiveTaskSessions(ctx)
+	if err != nil {
+		s.logger.Error("failed to list native recovery sessions", zap.Error(err))
+		return
+	}
+	for _, session := range sessions {
+		if ctx.Err() != nil {
+			return
+		}
+		if err := inputmeta.ValidateNativeTurnProtocol(models.StringFromAny(session.AgentProfileSnapshot["native_turn_protocol"])); err != nil {
+			if updated, at, changed := s.persistTaskSessionState(ctx, session.ID, session, session.State, err.Error()); changed {
+				s.publishTaskSessionStateChanged(ctx, session.TaskID, session.ID, session.State, session.State, err.Error(), at, updated)
+			}
+			continue
+		}
+		if session.State == models.TaskSessionStateCreated || !s.hasNativeTurnProtocol(ctx, session) {
+			continue
+		}
+		running, err := s.repo.GetExecutorRunningBySessionID(ctx, session.ID)
+		if err != nil || running == nil || running.ResumeToken == "" {
+			s.logger.Error("native recovery session has no persisted ACP identity", zap.String("session_id", session.ID), zap.Error(err))
+			continue
+		}
+		if _, err := s.executor.ResumeSession(ctx, session, true); err != nil && !errors.Is(err, executor.ErrExecutionAlreadyRunning) {
+			s.logger.Error("native session recovery launch failed", zap.String("session_id", session.ID), zap.Error(err))
+			attempt := s.nextTransientAttempt(session.ID)
+			s.scheduleTransientRetry(session.TaskID, session.ID, "", attempt, transientRetryDelay(attempt))
+		}
+	}
+}
