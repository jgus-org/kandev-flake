+func TestKandevPendingIntakeAutomaticallyRetriesPastGenericBudget(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		svc, _ := newTransientTestService(t)
+		t.Cleanup(svc.cancelAllTransientRetries)
+		repo := svc.repo.(*sqliterepo.Repository)
+		manager := svc.agentManager.(*mockAgentManager)
+		manager.isAgentRunning = true
+		seedExecutorRunning(t, repo, "s1", "t1", "execution")
+		session, err := repo.GetTaskSession(t.Context(), "s1")
+		require.NoError(t, err)
+		session.State = models.TaskSessionStateRunning
+		session.AgentProfileSnapshot = map[string]interface{}{"agent_name": "different-agent-identity", "native_turn_protocol": inputmeta.NativeTurnProtocolV1}
+		require.NoError(t, repo.UpdateTaskSession(t.Context(), session))
+		input := inputmeta.Input{Source: "HUMAN", EventID: "pending", Text: "steer", Context: "frozen", TurnID: "T1", Steer: true}
+		_, err = svc.persistKandevIntake(t.Context(), "t1", "s1", input.Text, "", false, nil, input, true)
+		require.NoError(t, err)
+		attempts := make(chan struct{}, 1)
+		count := 0
+		manager.steerInputCapture = func(actual inputmeta.Input) {
+			require.Equal(t, input, actual)
+			count++
+			manager.steerErr = errors.New("transport unavailable")
+			if count > transientMaxAttempts+1 {
+				manager.steerErr = nil
+			}
+			attempts <- struct{}{}
+		}
+		require.True(t, svc.resolveKandevIntake(t.Context(), "s1"))
+		for range transientMaxAttempts + 2 {
+			<-attempts
+		}
+		synctest.Wait()
+		require.Equal(t, 0, svc.messageQueue.GetStatus(t.Context(), "s1").Count)
+		require.Empty(t, manager.capturedPromptCalls)
+		session, err = repo.GetTaskSession(t.Context(), "s1")
+		require.NoError(t, err)
+		require.Equal(t, models.TaskSessionStateRunning, session.State)
+	})
