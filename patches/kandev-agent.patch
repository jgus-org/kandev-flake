+func TestSendQueuedNowRestoresPreclaimAfterDisconnectedRequest(t *testing.T) {
+	ctx := t.Context()
+	repo := setupTestRepo(t)
+	seedSession(t, repo, "task-1", "session-1", "step-1")
+	seedExecutorRunning(t, repo, "session-1", "task-1", "exec-1")
+	session, err := repo.GetTaskSession(ctx, "session-1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	session.State = models.TaskSessionStateRunning
+	if err := repo.UpdateTaskSession(ctx, session); err != nil {
+		t.Fatal(err)
+	}
+	cancelEntered := make(chan struct{}, 1)
+	cancelRelease := make(chan struct{})
+	var release sync.Once
+	t.Cleanup(func() { release.Do(func() { close(cancelRelease) }) })
+	manager := &mockAgentManager{
+		isAgentRunning:         true,
+		repoForExecutionLookup: repo,
+		cancelAgentEntered:     cancelEntered,
+		cancelAgentBlock:       cancelRelease,
+		cancelAgentErr:         errors.New("fixture cancellation failed"),
+	}
+	svc := createTestServiceWithAgent(repo, newMockStepGetter(), newMockTaskRepo(), manager)
+	svc.executor = executor.NewExecutor(manager, repo, testLogger(), executor.ExecutorConfig{})
+	eventBus := bus.NewMemoryEventBus(testLogger())
+	svc.eventBus = eventBus
+	restored := make(chan struct{}, 1)
+	_, err = eventBus.Subscribe(events.MessageQueueStatusChanged, func(_ context.Context, event *bus.Event) error {
+		status, ok := event.Data.(map[string]interface{})
+		if ok && status["count"] == 1 {
+			restored <- struct{}{}
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	queued, err := svc.messageQueue.QueueMessage(ctx, "session-1", "task-1", "queued original", "", messagequeue.QueuedByUser, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	requestCtx, disconnect := context.WithCancel(ctx)
+	requestDone := make(chan error, 1)
+	go func() {
+		_, err := svc.SendQueuedNow(requestCtx, "session-1", QueueSendNowScopeEntry, queued.ID)
+		requestDone <- err
+	}()
+	<-cancelEntered
+	if status := svc.messageQueue.GetStatus(ctx, "session-1"); status.Count != 0 {
+		t.Fatalf("preclaimed queue count = %d, want 0", status.Count)
+	}
+	disconnect()
+	if err := <-requestDone; !errors.Is(err, context.Canceled) {
+		t.Fatalf("disconnected request error = %v", err)
+	}
+	if status := svc.messageQueue.GetStatus(ctx, "session-1"); status.Count != 0 {
+		t.Fatalf("disconnected request restored an active claim: %d", status.Count)
+	}
+	release.Do(func() { close(cancelRelease) })
+	<-restored
+	status := svc.messageQueue.GetStatus(ctx, "session-1")
+	if status.Count != 1 || status.Entries[0].ID != queued.ID {
+		t.Fatalf("failed cancellation changed queued input: %#v", status.Entries)
+	}
+	if len(manager.capturedPromptCalls) != 0 {
+		t.Fatal("failed cancellation dispatched a replacement")
+	}
+}
