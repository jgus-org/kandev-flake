new file mode 100644
index 0000000..cc7409a
--- /dev/null
+++ b/apps/backend/internal/orchestrator/messagequeue/input_parts.go
@@ -0,0 +1,54 @@
+package messagequeue
+
+import (
+	"strings"
+
+	"github.com/google/uuid"
+	inputmeta "github.com/kandev/kandev/pkg/agent"
+)
+
+func queuedInput(entry *QueuedMessage) inputmeta.Input {
+	input, ok := inputmeta.InputFromMetadata(entry.Metadata, inputmeta.QueuedInputMetadataKey)
+	if ok && input.Context == entry.Content && !input.Steer {
+		if len(input.Parts) == 0 {
+			input.Parts = []inputmeta.InputPart{{Source: strings.ToLower(input.Source), EventID: input.EventID, Text: input.Text}}
+		}
+		return input
+	}
+	eventID := entry.ID
+	if eventID == "" {
+		eventID = uuid.NewString()
+	}
+	return inputmeta.NewQueuedInput("CLIENT", eventID, entry.Content)
+}
+
+func composedQueuedInput(target, source *QueuedMessage, separator, content string) (inputmeta.Input, error) {
+	parts := inputmeta.JoinInputParts(queuedInput(target).Parts, queuedInput(source).Parts, separator)
+	input, err := inputmeta.ComposeInputParts(parts)
+	if err != nil {
+		return inputmeta.Input{}, err
+	}
+	input.Context = content
+	return input, nil
+}
+
+func IsPreparedNativeIntake(entry *QueuedMessage) bool {
+	prepared, _ := entry.Metadata["kandev_intake_prepared"].(bool)
+	input, valid := inputmeta.InputFromMetadata(entry.Metadata, inputmeta.QueuedInputMetadataKey)
+	return prepared || (valid && input.Steer)
+}
+
+func IsStrictNativeIntake(entry *QueuedMessage) bool {
+	strict, _ := entry.Metadata["kandev_intake_strict_owner"].(bool)
+	return strict
+}
+
+func strictNativeIntakeMatches(metadata map[string]interface{}, expected inputmeta.Input) bool {
+	strict, _ := metadata["kandev_intake_strict_owner"].(bool)
+	input, valid := inputmeta.InputFromMetadata(metadata, inputmeta.QueuedInputMetadataKey)
+	return strict && valid && input.Steer && input.Source == "CLIENT" && input.EventID != "" && input.TurnID != "" && input.EventID == expected.EventID && input.TurnID == expected.TurnID
+}
+
+func QueuedPartCount(entry *QueuedMessage) int {
+	return len(queuedInput(entry).Parts)
+}
