+func TestKandevRecoveryAndPublicationSurviveLoadSuppression(t *testing.T) {
+	adapter := newTestAdapter()
+	defer adapter.Close()
+	adapter.agentID = "different-agent-identity"
+	adapter.cfg.NativeTurnProtocol = inputmeta.NativeTurnProtocolV1
+	adapter.isLoadingSession = true
+	for _, state := range []string{"started", "finished"} {
+		adapter.handleACPUpdate(sdk.SessionNotification{SessionId: "session", Meta: map[string]any{"kandev_recovery": state, "kandev_turn_id": "turn-1"}}, 0)
+		event := <-adapter.updatesCh
+		if event.Type != "kandev_recovery" || event.Data["state"] != state || event.TurnID != "turn-1" {
+			t.Fatalf("lost recovery: %#v", event)
+		}
+	}
+	adapter.handleACPUpdate(sdk.SessionNotification{SessionId: "session", Meta: map[string]any{"publication_id": "final-1", "kandev_turn_id": "turn-1"}, Update: sdk.SessionUpdate{AgentMessageChunk: &sdk.SessionUpdateAgentMessageChunk{Content: sdk.TextBlock("final text")}}}, 0)
+	event := <-adapter.updatesCh
+	if event.Type != "kandev_publication" || event.Data["publication_id"] != "final-1" || event.Text != "final text" || event.TurnID != "turn-1" {
+		t.Fatalf("lost publication: %#v", event)
+	}
