diff --git a/apps/backend/pkg/agent/input.go b/apps/backend/pkg/agent/input.go
new file mode 100644
index 0000000..ac024b7
--- /dev/null
+++ b/apps/backend/pkg/agent/input.go
@@ -0,0 +1,66 @@
+package agent
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+)
+
+const InitialInputMetadataKey = "kandev_initial_input"
+const QueuedInputMetadataKey = "kandev_input"
+const NativeTurnProtocolV1 = "kandev-turn/v1"
+const NativeTurnProtocolV2 = "kandev-turn/v2"
+
+func ValidateNativeTurnProtocol(protocol string) error {
+	if protocol != "" && protocol != NativeTurnProtocolV1 && protocol != NativeTurnProtocolV2 {
+		return fmt.Errorf("unsupported native turn protocol %q", protocol)
+	}
+	return nil
+}
+
+var ErrTurnClosed = errors.New("Kandev turn is closed")
+
+type Input struct {
+	TurnID  string      `json:"turn_id,omitempty"`
+	Steer   bool        `json:"steer,omitempty"`
+	Source  string      `json:"source"`
+	EventID string      `json:"event_id"`
+	Text    string      `json:"text"`
+	Context string      `json:"context,omitempty"`
+	Parts   []InputPart `json:"parts,omitempty"`
+}
+
+type inputContextKey struct{}
+type intakePersistenceKey struct{}
+
+func WithIntakePersistence(ctx context.Context, persist func(context.Context, Input) error) context.Context {
+	return context.WithValue(ctx, intakePersistenceKey{}, persist)
+}
+
+func PersistIntake(ctx context.Context, input Input) error {
+	if persist, ok := ctx.Value(intakePersistenceKey{}).(func(context.Context, Input) error); ok {
+		return persist(ctx, input)
+	}
+	return nil
+}
+
+func WithInput(ctx context.Context, input Input) context.Context {
+	return context.WithValue(ctx, inputContextKey{}, input)
+}
+func InputFromContext(ctx context.Context) (Input, bool) {
+	input, ok := ctx.Value(inputContextKey{}).(Input)
+	return input, ok
+}
+
+func InputFromMetadata(metadata map[string]interface{}, key string) (Input, bool) {
+	encoded, err := json.Marshal(metadata[key])
+	if err != nil {
+		return Input{}, false
+	}
+	var input Input
+	if json.Unmarshal(encoded, &input) != nil || input.EventID == "" || (input.Source != "HUMAN" && input.Source != "CLIENT") || !input.PartsValid() {
+		return Input{}, false
+	}
+	return input, true
+}
diff --git a/apps/backend/pkg/agent/input_parts.go b/apps/backend/pkg/agent/input_parts.go
new file mode 100644
index 0000000..f6abcb5
--- /dev/null
+++ b/apps/backend/pkg/agent/input_parts.go
@@ -0,0 +1,89 @@
+package agent
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"errors"
+	"strings"
+)
+
+type InputPart struct {
+	Source  string `json:"source"`
+	EventID string `json:"event_id"`
+	Text    string `json:"text"`
+	Before  string `json:"before"`
+}
+
+func NewQueuedInput(source, eventID, text string) Input {
+	part := InputPart{Source: strings.ToLower(source), EventID: eventID, Text: text}
+	return Input{Source: strings.ToUpper(part.Source), EventID: eventID, Text: text, Context: text, Parts: []InputPart{part}}
+}
+
+func ComposeInputParts(parts []InputPart) (Input, error) {
+	if len(parts) == 0 {
+		return Input{}, errors.New("input parts are empty")
+	}
+	seen := make(map[string]struct{}, len(parts))
+	var text strings.Builder
+	for index, part := range parts {
+		if part.EventID == "" || (part.Source != "human" && part.Source != "client") {
+			return Input{}, errors.New("input part identity is invalid")
+		}
+		if _, exists := seen[part.EventID]; exists {
+			return Input{}, errors.New("input part identity is repeated")
+		}
+		seen[part.EventID] = struct{}{}
+		if index == 0 && part.Before != "" {
+			return Input{}, errors.New("first input part has a separator")
+		}
+		if part.Before != "" && part.Before != "\n\n" && part.Before != "\n\n---\n\n" {
+			return Input{}, errors.New("input part separator is invalid")
+		}
+		text.WriteString(part.Before)
+		text.WriteString(part.Text)
+	}
+	copyParts := append([]InputPart(nil), parts...)
+	input := Input{Parts: copyParts, Text: text.String(), Context: text.String()}
+	if len(parts) == 1 {
+		input.Source = strings.ToUpper(parts[0].Source)
+		input.EventID = parts[0].EventID
+		return input, nil
+	}
+	input.Source = "CLIENT"
+	digest := sha256.New()
+	digest.Write([]byte("kandev-input-batch-v1"))
+	var length [8]byte
+	binary.BigEndian.PutUint64(length[:], uint64(len(parts)))
+	digest.Write(length[:])
+	for _, part := range parts {
+		for _, field := range []string{part.Source, part.EventID, part.Text, part.Before} {
+			binary.BigEndian.PutUint64(length[:], uint64(len(field)))
+			digest.Write(length[:])
+			digest.Write([]byte(field))
+		}
+	}
+	input.EventID = "batch-" + hex.EncodeToString(digest.Sum(nil))
+	return input, nil
+}
+
+func (input Input) PartsValid() bool {
+	if input.Parts == nil {
+		return true
+	}
+	if len(input.Parts) == 0 {
+		return false
+	}
+	composed, err := ComposeInputParts(input.Parts)
+	return err == nil && input.Source == composed.Source && input.EventID == composed.EventID && input.Text == composed.Text
+}
+
+func JoinInputParts(first, second []InputPart, separator string) []InputPart {
+	joined := append([]InputPart(nil), first...)
+	if len(second) == 0 {
+		return joined
+	}
+	addition := append([]InputPart(nil), second...)
+	addition[0].Before = separator + addition[0].Before
+	return append(joined, addition...)
+}
