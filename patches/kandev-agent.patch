+package backendapp
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/kandev/kandev/internal/task/models"
+	taskservice "github.com/kandev/kandev/internal/task/service"
+	"github.com/stretchr/testify/require"
+)
+
+func TestKandevPublicationReplayAfterAdapterReplacement(t *testing.T) {
+	harness := newPluginMoveErrorBindingHarness(t)
+	harness.createTask(t, "publication-task", false)
+	harness.createSession(t, "publication-session", "publication-task", models.TaskSessionStateRunning)
+	ctx := context.Background()
+	now := time.Now().UTC()
+	require.NoError(t, harness.repo.CreateTurn(ctx, &models.Turn{ID: "publication-turn", TaskID: "publication-task", TaskSessionID: "publication-session", StartedAt: now, CreatedAt: now, UpdatedAt: now}))
+	for range 2 {
+		adapter := &messageCreatorAdapter{svc: harness.adapter.svc.(*taskservice.Service), logger: newTestLogger()}
+		require.NoError(t, adapter.CreateAgentMessageStreaming(ctx, "kandev-publication-id", "publication-task", "final answer", "publication-session", "publication-turn"))
+
+	}
+	messages, err := harness.repo.ListMessages(ctx, "publication-session")
+	require.NoError(t, err)
+	require.Len(t, messages, 1)
+	require.Equal(t, "final answer", messages[0].Content)
+	adapter := &messageCreatorAdapter{svc: harness.adapter.svc.(*taskservice.Service), logger: newTestLogger()}
+	require.Error(t, adapter.CreateAgentMessageStreaming(ctx, "kandev-publication-unbound", "publication-task", "unbound historical answer", "publication-session", ""))
+	messages, err = harness.repo.ListMessages(ctx, "publication-session")
+	require.NoError(t, err)
+	require.Len(t, messages, 1)
+}
