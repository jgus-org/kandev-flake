@@ -0,0 +1,27 @@
+package appctx
+
+import (
+	"context"
+	"testing"
+)
+
+type inputKey struct{}
+
+func TestDetachedRetainsValuesWithoutParentCancellation(t *testing.T) {
+	parent, cancelParent := context.WithCancel(context.WithValue(context.Background(), inputKey{}, "human"))
+	stop := make(chan struct{})
+	ctx, cancel := Detached(parent, stop, 0)
+	defer cancel()
+	if got := ctx.Value(inputKey{}); got != "human" {
+		t.Fatalf("detached value = %v", got)
+	}
+	cancelParent()
+	if err := ctx.Err(); err != nil {
+		t.Fatalf("detached context cancelled with parent: %v", err)
+	}
+	close(stop)
+	<-ctx.Done()
+	if err := ctx.Err(); err != context.Canceled {
+		t.Fatalf("detached context after stop = %v", err)
+	}
+}
