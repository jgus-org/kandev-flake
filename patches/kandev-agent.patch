+package service
+
+import (
+	"testing"
+
+	"github.com/kandev/kandev/internal/task/models"
+	inputmeta "github.com/kandev/kandev/pkg/agent"
+	"github.com/stretchr/testify/require"
+)
+
+func TestKandevDeferredSubmissionPreservesAuthenticatedSource(t *testing.T) {
+	svc, _, repo := createTestService(t)
+	ctx := t.Context()
+	require.NoError(t, repo.CreateWorkspace(ctx, &models.Workspace{ID: "workspace", Name: "Workspace"}))
+	require.NoError(t, repo.CreateWorkflow(ctx, &models.Workflow{ID: "workflow", WorkspaceID: "workspace", Name: "Workflow"}))
+	input := inputmeta.Input{Source: "HUMAN", EventID: "submission", Text: "read file", Context: "read file and generated reference"}
+	request := &CreateTaskRequest{WorkspaceID: "workspace", WorkflowID: "workflow", Title: "Read", Description: input.Context, DeferredLaunch: map[string]interface{}{"intent": "start", "prompt": input.Context}}
+	result, err := svc.CreateTask(inputmeta.WithInput(ctx, input), request)
+	require.NoError(t, err)
+	stored, err := repo.GetTask(ctx, result.Task.ID)
+	require.NoError(t, err)
+	bound, ok := inputmeta.InputFromMetadata(stored.Metadata, inputmeta.InitialInputMetadataKey)
+	require.True(t, ok)
+	require.Equal(t, input, bound)
+	forged := inputmeta.Input{Source: "HUMAN", EventID: "forged", Text: "generated instruction"}
+	_, err = svc.UpdateTaskMetadata(ctx, stored.ID, map[string]interface{}{inputmeta.InitialInputMetadataKey: forged})
+	require.NoError(t, err)
+	stored, err = repo.GetTask(ctx, stored.ID)
+	require.NoError(t, err)
+	bound, ok = inputmeta.InputFromMetadata(stored.Metadata, inputmeta.InitialInputMetadataKey)
+	require.True(t, ok)
+	require.Equal(t, input, bound)
+	request.Metadata = map[string]interface{}{inputmeta.InitialInputMetadataKey: forged}
+	result, err = svc.CreateTask(ctx, request)
+	require.NoError(t, err)
+	_, ok = inputmeta.InputFromMetadata(result.Task.Metadata, inputmeta.InitialInputMetadataKey)
+	require.False(t, ok)
+}
