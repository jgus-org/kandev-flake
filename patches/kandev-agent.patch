+func TestKandevStartupResumesWithoutBrowserOrPrompt(t *testing.T) {
+	ctx := t.Context()
+	repo := setupTestRepo(t)
+	manager := &mockAgentManager{repoForExecutionLookup: repo}
+	manager.getExecutionIDForSessionFunc = func(context.Context, string) (string, error) { return "", executor.ErrExecutionNotFound }
+	var resumed []string
+	manager.launchAgentFunc = func(_ context.Context, request *executor.LaunchAgentRequest) (*executor.LaunchAgentResponse, error) {
+		resumed = append(resumed, request.ACPSessionID)
+		return &executor.LaunchAgentResponse{AgentExecutionID: "restored-" + request.SessionID}, nil
+	}
+	taskRepo := newMockTaskRepo()
+	svc := createTestServiceWithScheduler(repo, newMockStepGetter(), taskRepo, manager)
+	svc.scheduler = scheduler.NewScheduler(queue.NewTaskQueue(100), svc.executor, taskRepo, testLogger(), scheduler.DefaultSchedulerConfig())
+	svc.turnService = &repoTurnService{repo: repo}
+	memoryBus := eventbus.NewMemoryEventBus(testLogger())
+	t.Cleanup(memoryBus.Close)
+	svc.eventBus = memoryBus
+	svc.watcher = watcher.NewWatcher(memoryBus, watcher.EventHandlers{}, "native-startup", testLogger())
+	for _, state := range []models.TaskSessionState{models.TaskSessionStateRunning, models.TaskSessionStateIdle, models.TaskSessionStateCompleted, models.TaskSessionStateCancelled} {
+		id := string(state)
+		seedTaskAndSession(t, repo, "task-"+id, id, state)
+		session, err := repo.GetTaskSession(ctx, id)
+		require.NoError(t, err)
+		session.AgentProfileSnapshot = map[string]interface{}{"agent_name": "different-agent-identity", "native_turn_protocol": inputmeta.NativeTurnProtocolV1}
+		session.AgentProfileID = "profile1"
+		require.NoError(t, repo.UpdateTaskSession(ctx, session))
+		seedExecutorRunning(t, repo, id, session.TaskID, "old-"+id)
+		running, err := repo.GetExecutorRunningBySessionID(ctx, id)
+		require.NoError(t, err)
+		running.ResumeToken = "acp-" + id
+		running.Resumable = true
+		require.NoError(t, repo.UpsertExecutorRunning(ctx, running))
+	}
+	now := time.Unix(1, 0).UTC()
+	for _, identity := range []string{"unsupported", "resume-only"} {
+		seedTaskAndSession(t, repo, "task-"+identity, identity, models.TaskSessionStateRunning)
+		session, err := repo.GetTaskSession(ctx, identity)
+		require.NoError(t, err)
+		protocol := ""
+		if identity == "unsupported" {
+			protocol = "future-turn/v999"
+		}
+		session.AgentProfileSnapshot = map[string]interface{}{"agent_name": "kandev-agent", "native_turn_protocol": protocol}
+		require.NoError(t, repo.UpdateTaskSession(ctx, session))
+		seedExecutorRunning(t, repo, identity, session.TaskID, "old-"+identity)
+	}
+	require.NoError(t, repo.CreateTurn(ctx, &models.Turn{ID: "open-turn", TaskID: "task-RUNNING", TaskSessionID: "RUNNING", StartedAt: now, CreatedAt: now, UpdatedAt: now}))
+	require.NoError(t, svc.Start(ctx))
+	t.Cleanup(func() { require.NoError(t, svc.Stop()) })
+	require.Equal(t, []string{"acp-RUNNING"}, resumed)
+	require.Empty(t, manager.capturedPromptCalls)
+	unsupported, err := repo.GetTaskSession(ctx, "unsupported")
+	require.NoError(t, err)
+	require.Equal(t, models.TaskSessionStateRunning, unsupported.State)
+	require.NotEmpty(t, unsupported.ErrorMessage)
+	active, err := repo.GetActiveTurnBySessionID(ctx, "RUNNING")
+	require.NoError(t, err)
+	require.Equal(t, "open-turn", active.ID)
+	require.NoError(t, svc.Stop())
+	session, err := repo.GetTaskSession(ctx, "RUNNING")
+	require.NoError(t, err)
+	require.NotEqual(t, models.TaskSessionStateCancelled, session.State)
+	require.NotEqual(t, models.TaskSessionStateCompleted, session.State)
+	require.NoError(t, svc.Start(ctx))
+	require.Equal(t, []string{"acp-RUNNING", "acp-RUNNING"}, resumed)
+	require.Empty(t, manager.capturedPromptCalls)
+}
