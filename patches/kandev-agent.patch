+func TestKandevClosedOwnerSteeringQueuesStableInput(t *testing.T) {
+	for _, rejected := range []bool{false, true} {
+		t.Run(map[bool]string{false: "unknown-intake", true: "closed-owner"}[rejected], func(t *testing.T) {
+			svc, _ := newTransientTestService(t)
+			t.Cleanup(svc.cancelAllTransientRetries)
+			repo := svc.repo.(*sqliterepo.Repository)
+			svc.config.ClaudeMidTurnSteering = true
+			manager := svc.agentManager.(*mockAgentManager)
+			manager.isAgentRunning = true
+			manager.steerErr = errors.New("intake acknowledgment unknown")
+			if rejected {
+				manager.steerErr = inputmeta.ErrTurnClosed
+			}
+			seedExecutorRunning(t, repo, "s1", "t1", "execution")
+			session, err := repo.GetTaskSession(t.Context(), "s1")
+			require.NoError(t, err)
+			session.State = models.TaskSessionStateRunning
+			session.AgentProfileSnapshot = map[string]interface{}{"agent_name": "different-agent-identity", "native_turn_protocol": inputmeta.NativeTurnProtocolV1}
+			require.NoError(t, repo.UpdateTaskSession(t.Context(), session))
+			advertisePromptQueueingForTest(t, svc, "s1")
+			svc.registerBackgroundTask("s1", "background")
+			svc.markForegroundIdle("s1")
+			svc.completeBackgroundTask("s1", "background")
+			input := inputmeta.Input{Source: "HUMAN", EventID: "stable-input", Text: "next request", Context: "next request", TurnID: "finished-turn"}
+			result, err := svc.SteerTask(inputmeta.WithInput(t.Context(), input), "t1", "s1", input.Text, "", false, nil)
+			if !rejected {
+				require.Error(t, err)
+				require.Nil(t, result)
+				require.Equal(t, 1, svc.messageQueue.GetStatus(t.Context(), "s1").Count)
+				require.ErrorIs(t, svc.checkSessionPromptable("t1", "s1", models.TaskSessionStateWaitingForInput), ErrAgentPromptInProgress)
+				return
+			}
+			require.NoError(t, err)
+			require.Equal(t, steerQueuedStopReason, result.StopReason)
+			status := svc.messageQueue.GetStatus(t.Context(), "s1")
+			require.Equal(t, 1, status.Count)
+			queued, ok := inputmeta.InputFromMetadata(status.Entries[0].Metadata, inputmeta.QueuedInputMetadataKey)
+			require.True(t, ok)
+			require.Equal(t, input.EventID, queued.EventID)
+			require.False(t, queued.Steer)
+			require.Empty(t, queued.TurnID)
+			require.Empty(t, manager.capturedPromptCalls)
+		})
+	}
+}
