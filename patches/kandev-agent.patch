+			captured := <-started
+			require.Equal(t, turn.ID, captured.TurnID)
+			require.Equal(t, source, captured.Source)
+			_, err = svc.SteerTask(t.Context(), "task1", "session1", "later steer", "", false, nil)
+			require.ErrorIs(t, err, ErrSteerNotEligible)
+			require.Empty(t, manager.getCapturedSteerCalls())
+			close(release)
+			require.Error(t, <-done)
+		})
+	}
