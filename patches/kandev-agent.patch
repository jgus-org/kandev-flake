+package handlers
+
+import (
+	"context"
+
+	"github.com/gin-gonic/gin"
+	"github.com/kandev/kandev/internal/auth/authn"
+	inputmeta "github.com/kandev/kandev/pkg/agent"
+	ws "github.com/kandev/kandev/pkg/websocket"
+)
+
+func browserSubmissionContext(ctx context.Context) context.Context {
+	if authn.IsVerifiedBrowser(ctx) {
+		return inputmeta.WithInput(ctx, inputmeta.Input{Source: "HUMAN"})
+	}
+	return ctx
+}
+
+func (h *MessageHandlers) wsSubmitMessage(ctx context.Context, message *ws.Message) (*ws.Message, error) {
+	return h.wsAddMessage(browserSubmissionContext(ctx), message)
+}
+
+func (h *TaskHandlers) httpSubmitTask(c *gin.Context) {
+	c.Request = c.Request.WithContext(browserSubmissionContext(c.Request.Context()))
+	h.httpCreateTask(c)
+}
