+func TestKandevResumeOnlyAgentDoesNotAcquireTurnProtocol(t *testing.T) {
+	adapter, capture := newSessionRequestCaptureAdapter(t, sdk.McpCapabilities{})
+	adapter.agentID = "kandev-agent"
+	adapter.cfg.NativeTurnProtocol = agents.NewClaudeACP().Runtime().SessionConfig.NativeTurnProtocol
+	capture.loadResponseMeta = map[string]any{"kandev_recovery": "active", "kandev_turn_id": "untrusted"}
+	if err := adapter.LoadSession(t.Context(), "session", nil); err != nil {
+		t.Fatal(err)
+	}
+	if adapter.AcknowledgesSteeringIntake() {
+		t.Fatal("ordinary resume enabled native intake")
+	}
+	for len(adapter.updatesCh) != 0 {
+		if event := <-adapter.updatesCh; event.Type == "kandev_recovery" {
+			t.Fatal("ordinary resume accepted native recovery metadata")
+		}
+	}
+	adapter.cfg.NativeTurnProtocol = "future-turn/v999"
+	if err := adapter.Initialize(t.Context()); err == nil {
+		t.Fatal("unsupported protocol initialized transport")
+	}
+}
+
+func TestKandevInputSurvivesACPDispatch(t *testing.T) {
+	adapter, capture := newSessionRequestCaptureAdapter(t, sdk.McpCapabilities{})
+	adapter.agentID = "different-agent-identity"
+	adapter.cfg.NativeTurnProtocol = inputmeta.NativeTurnProtocolV1
+	if _, err := adapter.NewSession(context.Background(), nil); err != nil {
+		t.Fatal(err)
+	}
+	ctx := inputmeta.WithInput(context.Background(), inputmeta.Input{Source: "CLIENT", EventID: "stored-message-id", Text: "user body", Context: "framework body"})
+	if err := adapter.Prompt(ctx, "composed body", nil, 1); err != nil {
+		t.Fatal(err)
+	}
+	input := capture.promptRequest.Meta["kandev_input"].(map[string]any)
+	if input["source"] != "CLIENT" || input["event_id"] != "stored-message-id" || input["context"] != "framework body" {
+		t.Fatalf("input lost: %#v", input)
+	}
+	if capture.promptRequest.Prompt[0].Text.Text != "user body" {
+		t.Fatal("framework context entered input body")
+	}
+}
+
+func TestKandevSteeringAcknowledgesIntakeWithoutCompletingTurn(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		adapter, capture := newSessionRequestCaptureAdapter(t, sdk.McpCapabilities{})
+		adapter.agentID = "different-agent-identity"
+		adapter.cfg.NativeTurnProtocol = inputmeta.NativeTurnProtocolV1
+		capture.promptResponseMeta = map[string]any{"kandev_intake": "accepted"}
+		capture.promptStarted, capture.releasePrompt = make(chan struct{}), make(chan struct{})
+		if _, err := adapter.NewSession(t.Context(), nil); err != nil {
+			t.Fatal(err)
+		}
+		input := inputmeta.Input{TurnID: "turn-1", Source: "HUMAN", EventID: "initial", Text: "read file"}
+		done := make(chan error, 1)
+		go func() { done <- adapter.Prompt(inputmeta.WithInput(t.Context(), input), input.Text, nil, 1) }()
+		<-capture.promptStarted
+		input.EventID = "steering"
+		if err := adapter.PromptSteer(inputmeta.WithInput(t.Context(), input), input.Text, nil, 1); err != nil {
+			t.Fatal(err)
+		}
+		synctest.Wait()
+		select {
+		case <-done:
+			t.Fatal("steering ended original turn")
+		default:
+		}
+		for len(adapter.updatesCh) != 0 {
+			if event := <-adapter.updatesCh; event.Type == "complete" {
+				t.Fatal("steering published synthetic completion")
+			}
+		}
+		close(capture.releasePrompt)
+		if err := <-done; err != nil {
+			t.Fatal(err)
+		}
+		capture.promptError = &sdk.RequestError{Code: -32003, Message: "Kandev turn is closed", Data: map[string]any{"kind": "kandev_turn_closed"}}
+		if err := adapter.PromptSteer(inputmeta.WithInput(t.Context(), input), input.Text, nil, 1); !errors.Is(err, inputmeta.ErrTurnClosed) {
+			t.Fatalf("closed-owner error: %v", err)
+		}
+	})
+}
