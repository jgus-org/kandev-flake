+	_, err = svc.CreatePublicationMessage(ctx, "missing-owner", &CreateMessageRequest{TaskSessionID: "sess-msg", Content: "old unassigned report", AuthorType: "agent"})
+	if err == nil {
+		t.Fatal("publication without owner inherited active turn")
+	}
+	messages, err = repo.ListMessages(ctx, "sess-msg")
+	if err != nil || len(messages) != 1 {
+		t.Fatal("missing-owner publication changed stored history")
+	}
+}
