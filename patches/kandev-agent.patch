+}
+
+func TestKandevOnlyDedicatedBrowserSubmissionAttestsHuman(t *testing.T) {
+	for _, test := range []struct {
+		name      string
+		dedicated bool
+		identity  authn.Identity
+		source    string
+	}{
+		{"browser submit", true, authn.Identity{UserID: "person", SessionID: "cookie"}, "HUMAN"},
+		{"generic browser message", false, authn.Identity{UserID: "person", SessionID: "cookie"}, "CLIENT"},
+		{"token submit", true, authn.Identity{UserID: "person", TokenID: "token"}, "CLIENT"},
+		{"synthetic submit", true, authn.Identity{UserID: "person", Synthetic: true}, "CLIENT"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			repo := &messageAddSwitchRepo{
+				tasks:     map[string]*models.Task{"task": {ID: "task", State: v1.TaskStateInProgress}},
+				sessions:  map[string]*models.TaskSession{"session": {ID: "session", TaskID: "task", State: models.TaskSessionStateRunning, AgentProfileID: "profile"}},
+				primaryID: "session",
+			}
+			log, err := logger.NewLogger(logger.LoggingConfig{Level: "error", Format: "json"})
+			require.NoError(t, err)
+			svc := service.NewService(service.Repos{Workspaces: repo, Tasks: repo, TaskRepos: repo, Workflows: repo, Messages: repo, Turns: repo, Sessions: repo, GitSnapshots: repo, RepoEntities: repo, Executors: repo, Environments: repo, TaskEnvironments: repo, Reviews: repo}, nil, log, service.RepositoryDiscoveryConfig{})
+			recorder := &submissionRecorder{planModeRecordingOrchestrator: newPlanModeRecordingOrchestrator(), inputs: make(chan inputmeta.Input, 1)}
+			handler := NewMessageHandlers(svc, recorder, log)
+			request, err := ws.NewRequest("request", "message.submit", map[string]any{"task_id": "task", "session_id": "session", "content": "read file", "kandev_input": map[string]any{"source": "HUMAN"}})
+			require.NoError(t, err)
+			ctx := authn.WithIdentity(t.Context(), test.identity)
+			var response *ws.Message
+			if test.dedicated {
+				response, err = handler.wsSubmitMessage(ctx, request)
+			} else {
+				response, err = handler.wsAddMessage(ctx, request)
+			}
+			require.NoError(t, err)
+			require.Equal(t, ws.MessageTypeResponse, response.Type)
+			input := <-recorder.inputs
+			require.Equal(t, test.source, input.Source)
+			require.Equal(t, "read file", input.Text)
+			require.NotEmpty(t, input.EventID)
+		})
+	}
+}
