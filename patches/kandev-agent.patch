+func TestKandevRecoveredCancellationWaitsForTerminalSignal(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		adapter, capture := newSessionRequestCaptureAdapter(t, sdk.McpCapabilities{})
+		adapter.agentID = "different-agent-identity"
+		adapter.cfg.NativeTurnProtocol = inputmeta.NativeTurnProtocolV1
+		capture.loadResponseMeta = map[string]any{"kandev_recovery": "active", "kandev_turn_id": "turn-1"}
+		capture.cancelStarted = make(chan struct{})
+		if err := adapter.LoadSession(t.Context(), "session", nil); err != nil {
+			t.Fatal(err)
+		}
+		done := make(chan error, 1)
+		ctx := inputmeta.WithInput(t.Context(), inputmeta.Input{TurnID: "turn-1", Source: "HUMAN"})
+		go func() { done <- adapter.Cancel(ctx) }()
+		<-capture.cancelStarted
+		if capture.cancelRequest.Meta["kandev_turn_id"] != "turn-1" {
+			t.Fatal("cancel lost originating turn")
+		}
+		if capture.cancelRequest.Meta["kandev_cancel_source"] != "HUMAN" {
+			t.Fatal("cancel lost source")
+		}
+		synctest.Wait()
+		select {
+		case err := <-done:
+			t.Fatalf("cancel returned before terminal recovery signal: %v", err)
+		default:
+		}
+		adapter.handleACPUpdate(sdk.SessionNotification{SessionId: "session", Meta: map[string]any{"kandev_recovery": "finished", "kandev_turn_id": "turn-1"}}, 0)
+		if err := <-done; err != nil {
+			t.Fatal(err)
+		}
+	})
+}
