+func TestSendQueuedNowConcurrentEditPreservesTurnAndQueue(t *testing.T) {
+	ctx := t.Context()
+	repo := setupTestRepo(t)
+	seedSession(t, repo, "task-1", "session-1", "step-1")
+	seedExecutorRunning(t, repo, "session-1", "task-1", "exec-1")
+	session, err := repo.GetTaskSession(ctx, "session-1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	session.State = models.TaskSessionStateRunning
+	if err := repo.UpdateTaskSession(ctx, session); err != nil {
+		t.Fatal(err)
+	}
+	manager := &mockAgentManager{isAgentRunning: true, repoForExecutionLookup: repo}
+	svc := createTestServiceWithAgent(repo, newMockStepGetter(), newMockTaskRepo(), manager)
+	svc.executor = executor.NewExecutor(manager, repo, testLogger(), executor.ExecutorConfig{})
+	svc.messageQueue = messagequeue.NewService(&editingClaimRepository{Repository: messagequeue.NewMemoryRepository()}, 10, testLogger())
+	queued, err := svc.messageQueue.QueueMessage(ctx, "session-1", "task-1", "original", "", messagequeue.QueuedByUser, false, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := svc.SendQueuedNow(ctx, "session-1", QueueSendNowScopeAll, ""); !errors.Is(err, ErrSendNowQueueChanged) {
+		t.Fatalf("concurrent edit error = %v", err)
+	}
+	if manager.cancelAgentCalls.Load() != 0 {
+		t.Fatal("concurrent queue edit cancelled the active turn")
+	}
+	status := svc.messageQueue.GetStatus(ctx, "session-1")
