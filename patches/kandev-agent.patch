diff --git a/apps/backend/internal/agent/runtime/lifecycle/kandev_publication_test.go b/apps/backend/internal/agent/runtime/lifecycle/kandev_publication_test.go
new file mode 100644
index 0000000..d858363
--- /dev/null
+++ b/apps/backend/internal/agent/runtime/lifecycle/kandev_publication_test.go
@@ -0,0 +1,137 @@
+package lifecycle
+
+import (
+	agentctl "github.com/kandev/kandev/internal/agent/runtime/agentctl"
+	inputmeta "github.com/kandev/kandev/pkg/agent"
+	v1 "github.com/kandev/kandev/pkg/api/v1"
+	"testing"
+	"testing/synctest"
+)
+
+func TestKandevPublicationIdentitySurvivesExecutionReplacement(t *testing.T) {
+	manager, bus := createTestManagerWithTracking()
+	for _, executionID := range []string{"before-crash", "after-crash"} {
+		execution := createTestExecution(executionID, "task", "session")
+		execution.AgentID = "different-agent-identity"
+		execution.NativeTurnProtocol = inputmeta.NativeTurnProtocolV1
+		manager.handleAgentEvent(execution, agentctl.AgentEvent{Type: "kandev_publication", Text: "final text", Data: map[string]any{"publication_id": "publication"}})
+	}
+	events := streamEventsOfType(bus, "message_streaming")
+	if len(events) != 2 {
+		t.Fatalf("events: %d", len(events))
+	}
+	if events[0].Data.MessageID != events[1].Data.MessageID || events[0].Data.IsAppend || events[1].Data.IsAppend {
+		t.Fatal("publication replay is not an idempotent insert")
+	}
+}
+
+func TestKandevPublicationFollowsInterimProse(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		manager, bus := createTestManagerWithTracking()
+		execution := createTestExecution("execution", "task", "session")
+		execution.NativeTurnProtocol = inputmeta.NativeTurnProtocolV1
+		manager.handleAgentEvent(execution, agentctl.AgentEvent{Type: "message_chunk", Text: "First\n"})
+		manager.handleAgentEvent(execution, agentctl.AgentEvent{Type: "message_chunk", Text: "Second\n"})
+		manager.handleAgentEvent(execution, agentctl.AgentEvent{Type: "kandev_publication", Text: "Report", Data: map[string]any{"publication_id": "publication"}})
+		events := streamEventsOfType(bus, "message_streaming")
+		if len(events) != 3 || events[0].Data.Text != "First\n" || events[1].Data.Text != "Second\n" || events[2].Data.Text != "Report" {
+			t.Fatalf("unexpected stream events: %+v", events)
+		}
+		if events[0].Data.MessageID != events[1].Data.MessageID || events[1].Data.MessageID == events[2].Data.MessageID || events[2].Data.IsAppend {
+			t.Fatal("interim prose and report publication have incorrect identities")
+		}
+	})
+}
+
+func TestKandevIdleReplayDoesNotStartWork(t *testing.T) {
+	manager, bus := createTestManagerWithTracking()
+	execution := createTestExecution("execution", "task", "session")
+	execution.AgentID = "different-agent-identity"
+	execution.NativeTurnProtocol = inputmeta.NativeTurnProtocolV1
+	execution.Status = v1.AgentStatusReady
+	execution.setSessionInitialized(true)
+	if err := manager.executionStore.Add(execution); err != nil {
+		t.Fatal(err)
+	}
+	manager.handleAgentEvent(execution, agentctl.AgentEvent{Type: "kandev_publication", Text: "prior report", Data: map[string]any{"publication_id": "prior"}})
+	manager.handleAgentEvent(execution, agentctl.AgentEvent{Type: "kandev_recovery", Data: map[string]any{"state": "finished"}})
+	if execution.Status != v1.AgentStatusReady {
+		t.Fatalf("idle replay changed status to %q", execution.Status)
+	}
+	for _, event := range bus.PublishedEvents {
+		if event.Subject == "agent.running" || event.Subject == "agent.ready" {
+			t.Fatalf("idle replay published turn lifecycle event %q", event.Subject)
+		}
+	}
+}
+
+func TestKandevRecoveryFinishedBeforeInitialization(t *testing.T) {
+	manager, _ := createTestManagerWithTracking()
+	execution := createTestExecution("execution", "task", "session")
+	execution.AgentID = "different-agent-identity"
+	execution.NativeTurnProtocol = inputmeta.NativeTurnProtocolV1
+	if err := manager.executionStore.Add(execution); err != nil {
+		t.Fatal(err)
+	}
+	manager.handleAgentEvent(execution, agentctl.AgentEvent{Type: "kandev_recovery", TurnID: "turn", Data: map[string]any{"state": "started"}})
+	manager.handleAgentEvent(execution, agentctl.AgentEvent{Type: "kandev_recovery", TurnID: "turn", Data: map[string]any{"state": "finished"}})
+	if execution.nativeRecoveryState != "finished" {
+		t.Fatal("late initialization lost recovery completion")
+	}
+	execution.setSessionInitialized(true)
+	if err := manager.markSessionBootReady(execution.ID); err != nil {
+		t.Fatal(err)
+	}
+	if execution.Status != v1.AgentStatusReady || execution.nativeRecoveryPendingCompletion {
+		t.Fatal("initialization did not settle completed recovery")
+	}
+}
+
+func TestKandevDelayedRecoveryFinishCannotCompleteSuccessor(t *testing.T) {
+	for _, owner := range []string{"turn-1", ""} {
+		for _, sameTurn := range []bool{false, true} {
+			manager, bus := createTestManagerWithTracking()
+			execution := createTestExecution("execution", "task", "session")
+			execution.AgentID = "different-agent-identity"
+			execution.NativeTurnProtocol = inputmeta.NativeTurnProtocolV1
+			execution.setSessionInitialized(true)
+			execution.setPromptTurnID("turn-1")
+			if err := manager.executionStore.Add(execution); err != nil {
+				t.Fatal(err)
+			}
+			manager.handleAgentEvent(execution, agentctl.AgentEvent{Type: "kandev_recovery", TurnID: "turn-1", Data: map[string]any{"state": "started"}})
+			release := make(chan struct{})
+			done := make(chan struct{})
+			go func() {
+				<-release
+				manager.handleAgentEvent(execution, agentctl.AgentEvent{Type: "kandev_recovery", TurnID: owner, Data: map[string]any{"state": "finished"}})
+				close(done)
+			}()
+			if !sameTurn {
+				execution.setPromptTurnID("turn-2")
+			}
+			if _, err := manager.executionStore.BeginPrompt(execution.ID); err != nil {
+				t.Fatal(err)
+			}
+			close(release)
+			<-done
+			if sameTurn && owner != "" && execution.Status != v1.AgentStatusReady {
+				t.Fatal("same-turn steering prevented recovery completion")
+			}
+			if (!sameTurn || owner == "") && execution.Status != v1.AgentStatusRunning {
+				t.Fatal("stale recovery completion ended successor")
+			}
+			for _, event := range bus.PublishedEvents {
+				if (!sameTurn || owner == "") && event.Subject == "agent.ready" {
+					t.Fatal("stale recovery completion published ready")
+				}
+			}
+			if sameTurn && owner == "" {
+				manager.handleAgentEvent(execution, agentctl.AgentEvent{Type: "kandev_recovery", TurnID: "turn-1", Data: map[string]any{"state": "finished"}})
+				if execution.Status != v1.AgentStatusReady {
+					t.Fatal("missing-owner completion consumed the valid completion")
+				}
+			}
+		}
+	}
+}
