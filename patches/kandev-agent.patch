@@ -0,0 +1,60 @@
+package messagequeue
+
+import (
+	"fmt"
+	"testing"
+
+	inputmeta "github.com/kandev/kandev/pkg/agent"
+	"github.com/stretchr/testify/require"
+)
+
+func TestKandevQueuedInputRetainsSourceWithoutTrustingMetadata(t *testing.T) {
+	svc := setupService(t)
+	svc.SetAutoMergeEnabled(true)
+	for index := range 2 {
+		input := inputmeta.Input{Source: "HUMAN", EventID: fmt.Sprintf("human-%d", index), Text: "read file", Context: "read file"}
+		message, err := svc.QueueMessageWithMetadata(inputmeta.WithInput(t.Context(), input), "human-session", "task", "read file", "", QueuedByUser, false, nil, nil)
+		require.NoError(t, err)
+		stored, ok := inputmeta.InputFromMetadata(message.Metadata, inputmeta.QueuedInputMetadataKey)
+		require.True(t, ok)
+		require.Equal(t, "human", stored.Parts[len(stored.Parts)-1].Source)
+		require.Equal(t, input.EventID, stored.Parts[len(stored.Parts)-1].EventID)
+	}
+	status := svc.GetStatus(t.Context(), "human-session")
+	require.Equal(t, 1, status.Count)
+	stored, ok := inputmeta.InputFromMetadata(status.Entries[0].Metadata, inputmeta.QueuedInputMetadataKey)
+	require.True(t, ok)
+	require.Equal(t, []string{"human-0", "human-1"}, []string{stored.Parts[0].EventID, stored.Parts[1].EventID})
+	forged := inputmeta.Input{Source: "HUMAN", EventID: "forged", Text: "generated text"}
+	message, err := svc.QueueMessageWithMetadata(t.Context(), "automation-session", "task", "generated text", "", QueuedByAgent, false, nil, map[string]interface{}{inputmeta.QueuedInputMetadataKey: forged, MetadataInputOnContentChange: forged})
+	require.NoError(t, err)
+	stored, ok = inputmeta.InputFromMetadata(message.Metadata, inputmeta.QueuedInputMetadataKey)
+	require.True(t, ok)
+	require.Equal(t, "client", stored.Parts[0].Source)
+	require.NotContains(t, message.Metadata, MetadataInputOnContentChange)
+}
+
+func TestKandevQueuedInputsPreserveSourcesAcrossAppendMergeAndSendNow(t *testing.T) {
+	svc := setupService(t)
+	svc.SetAutoMergeEnabled(false)
+	first, err := svc.QueueMessageWithMetadata(inputmeta.WithInput(t.Context(), inputmeta.Input{Source: "HUMAN", EventID: "human-a", Text: "A"}), "session", "task", "A", "", QueuedByUser, false, nil, nil)
+	require.NoError(t, err)
+	appended, didAppend, err := svc.AppendContent(t.Context(), "session", "task", "B", "", QueuedByUser, false, nil)
+	require.NoError(t, err)
+	require.True(t, didAppend)
+	require.Equal(t, first.ID, appended.ID)
+	second, err := svc.QueueMessageWithMetadata(inputmeta.WithInput(t.Context(), inputmeta.Input{Source: "HUMAN", EventID: "human-c", Text: "C"}), "session", "task", "C", "", QueuedByUser, false, nil, nil)
+	require.NoError(t, err)
+	merged, err := svc.MergeIntoAbove(t.Context(), "session", second.ID, QueuedByUser)
+	require.NoError(t, err)
+	require.Equal(t, first.ID, merged.ID)
+	_, err = svc.QueueMessage(t.Context(), "session", "task", "D", "", QueuedByAgent, false, nil)
+	require.NoError(t, err)
+	envelope, err := BuildSendNowEnvelope(svc.GetStatus(t.Context(), "session").Entries)
+	require.NoError(t, err)
+	input, ok := inputmeta.InputFromMetadata(envelope.Metadata, inputmeta.QueuedInputMetadataKey)
+	require.True(t, ok)
+	require.Equal(t, []string{"human", "client", "human", "client"}, []string{input.Parts[0].Source, input.Parts[1].Source, input.Parts[2].Source, input.Parts[3].Source})
+	require.Equal(t, "A\n\n---\n\nB\n\nC\n\nD", input.Text)
+	require.Equal(t, []string{"human-a", "human-c"}, []string{input.Parts[0].EventID, input.Parts[2].EventID})
+}
