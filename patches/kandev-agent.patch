@@ -0,0 +1,40 @@
+package agents
+
+import (
+	"context"
+	"time"
+
+	"github.com/kandev/kandev/internal/agent/usage"
+	"github.com/kandev/kandev/pkg/agent"
+)
+
+type KandevAgent struct{}
+
+func NewKandevAgent() *KandevAgent           { return &KandevAgent{} }
+func (*KandevAgent) ID() string              { return "kandev-agent" }
+func (*KandevAgent) Name() string            { return "Kandev Agent" }
+func (*KandevAgent) DisplayName() string     { return "Kandev Agent" }
+func (*KandevAgent) Description() string     { return "Durable ACP sessions with workspace reads." }
+func (*KandevAgent) Enabled() bool           { return true }
+func (*KandevAgent) DisplayOrder() int       { return 15 }
+func (*KandevAgent) Logo(LogoVariant) []byte { return nil }
+func (*KandevAgent) IsInstalled(ctx context.Context) (*DiscoveryResult, error) {
+	result, err := Detect(ctx, WithCommand("kandev-agent"))
+	if result != nil {
+		result.Capabilities.SupportsSessionResume = true
+	}
+	return result, err
+}
+func (*KandevAgent) BuildCommand(CommandOptions) Command              { return Cmd("kandev-agent").Build() }
+func (*KandevAgent) PermissionSettings() map[string]PermissionSetting { return emptyPermSettings }
+func (*KandevAgent) RemoteAuth() *RemoteAuth                          { return nil }
+func (*KandevAgent) InstallScript() string                            { return "" }
+func (*KandevAgent) BillingType() usage.BillingType                   { return defaultBillingType() }
+func (*KandevAgent) Runtime() *RuntimeConfig {
+	recoverable := true
+	return &RuntimeConfig{
+		Cmd: Cmd("kandev-agent").Build(), WorkingDir: "{workspace}", Protocol: agent.ProtocolACP,
+		ResourceLimits: ResourceLimits{MemoryMB: 4096, CPUCores: 2, Timeout: time.Hour},
+		SessionConfig:  SessionConfig{NativeSessionResume: true, NativeTurnProtocol: agent.NativeTurnProtocolV2, CanRecover: &recoverable, SessionDirTemplate: "{home}/.local/state/kandev-agent"},
+	}
+}
