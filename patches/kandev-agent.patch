+func TestKandevLostIntakeReceiptResolvesBeforeSuccessor(t *testing.T) {
+	for _, committed := range []bool{false, true} {
+		t.Run(map[bool]string{false: "never-committed", true: "committed"}[committed], func(t *testing.T) {
+			svc, _ := newTransientTestService(t)
+			repo := svc.repo.(*sqliterepo.Repository)
+			manager := svc.agentManager.(*mockAgentManager)
+			manager.isAgentRunning = true
+			session, err := repo.GetTaskSession(t.Context(), "s1")
+			require.NoError(t, err)
+			session.AgentProfileSnapshot = map[string]interface{}{"native_turn_protocol": inputmeta.NativeTurnProtocolV1}
+			require.NoError(t, repo.UpdateTaskSession(t.Context(), session))
+			db := sqlx.NewDb(repo.DB(), "sqlite3")
+			queueRepo, err := messagequeue.NewSQLiteRepository(db, db)
+			require.NoError(t, err)
+			svc.messageQueue = messagequeue.NewService(queueRepo, 10, testLogger())
+			seedExecutorRunning(t, repo, "s1", "t1", "execution")
+			original := inputmeta.Input{Source: "HUMAN", EventID: "stable-input", Text: "follow up", Context: "frozen wrapper", TurnID: "closed-T1", Steer: true}
+			entry, err := svc.persistKandevIntake(t.Context(), "t1", "s1", original.Text, "", false, nil, original, committed)
+			require.NoError(t, err)
+			queueRepo, err = messagequeue.NewSQLiteRepository(db, db)
+			require.NoError(t, err)
+			svc.messageQueue = messagequeue.NewService(queueRepo, 10, testLogger())
+			manager.steerInputCapture = func(retry inputmeta.Input) {
+				require.Equal(t, original, retry)
+				stored, err := svc.messageQueue.GetEntry(t.Context(), "s1", entry.ID)
+				require.NoError(t, err)
+				require.Equal(t, true, stored.Metadata[nativeIntakePreparedKey])
+			}
+			if !committed {
+				manager.steerErr = inputmeta.ErrTurnClosed
+			}
+			svc.handleAgentRunning(t.Context(), watcher.AgentEventData{NativeTurnProtocol: inputmeta.NativeTurnProtocolV1, AgentID: "different-agent-identity", SessionID: "s1"})
+			status := svc.messageQueue.GetStatus(t.Context(), "s1")
+			if committed {
+				require.Equal(t, 0, status.Count)
+			} else {
+				require.Equal(t, 1, status.Count)
+				require.Equal(t, entry.ID, status.Entries[0].ID)
+				input, ok := inputmeta.InputFromMetadata(status.Entries[0].Metadata, inputmeta.QueuedInputMetadataKey)
+				require.True(t, ok)
+				require.Equal(t, original.EventID, input.EventID)
+				require.Empty(t, input.TurnID)
+				require.False(t, input.Steer)
+			}
+			require.Empty(t, manager.capturedPromptCalls)
+		})
+	}
+}
