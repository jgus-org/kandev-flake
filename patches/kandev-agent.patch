--- /dev/null
+++ b/apps/backend/internal/orchestrator/handlers/queue_input_provenance_test.go
@@ -0,0 +1,69 @@
+package handlers
+
+import (
+	"context"
+	"testing"
+
+	"github.com/kandev/kandev/internal/auth/authn"
+	"github.com/kandev/kandev/internal/orchestrator/messagequeue"
+	inputmeta "github.com/kandev/kandev/pkg/agent"
+	ws "github.com/kandev/kandev/pkg/websocket"
+	"github.com/stretchr/testify/require"
+)
+
+func TestQueuedBrowserSubmissionAndEditsRetainOriginalSources(t *testing.T) {
+	handlers, queue := setupQueueHandlers(t)
+	browser := authn.WithIdentity(t.Context(), authn.Identity{UserID: "person", SessionID: "cookie"})
+	pat := authn.WithIdentity(t.Context(), authn.Identity{UserID: "automation", TokenID: "pat"})
+	message := func(action, content string) *ws.Message {
+		return createTestMessage(t, action, map[string]interface{}{
+			"session_id": "session", "task_id": "task", "content": content,
+		})
+	}
+	response, err := handlers.wsSubmitQueuedMessage(browser, message(ws.ActionMessageQueueSubmit, "human original"))
+	require.NoError(t, err)
+	require.Equal(t, ws.MessageTypeResponse, response.Type)
+	first := queue.GetStatus(t.Context(), "session").Entries[0]
+	firstInput, ok := inputmeta.InputFromMetadata(first.Metadata, inputmeta.QueuedInputMetadataKey)
+	require.True(t, ok)
+	require.Equal(t, "human", firstInput.Parts[0].Source)
+
+	response, err = handlers.wsQueueMessage(browser, message(ws.ActionMessageQueueAdd, "generic browser request"))
+	require.NoError(t, err)
+	require.Equal(t, ws.MessageTypeResponse, response.Type)
+	response, err = handlers.wsSubmitQueuedMessage(pat, message(ws.ActionMessageQueueSubmit, "token request"))
+	require.NoError(t, err)
+	require.Equal(t, ws.MessageTypeResponse, response.Type)
+
+	edit := func(ctx context.Context, action, entryID, content string, trusted bool) {
+		request := createTestMessage(t, action, map[string]interface{}{
+			"session_id": "session", "entry_id": entryID, "content": content,
+		})
+		var response *ws.Message
+		var err error
+		if trusted {
+			response, err = handlers.wsSubmitQueuedUpdate(ctx, request)
+		} else {
+			response, err = handlers.wsUpdateMessage(ctx, request)
+		}
+		require.NoError(t, err)
+		require.Equal(t, ws.MessageTypeResponse, response.Type)
+	}
+	edit(browser, ws.ActionMessageQueueSubmitUpdate, first.ID, first.Content, true)
+	unchanged := queue.GetStatus(t.Context(), "session").Entries[0]
+	unchangedInput, ok := inputmeta.InputFromMetadata(unchanged.Metadata, inputmeta.QueuedInputMetadataKey)
+	require.True(t, ok)
+	require.Equal(t, firstInput.EventID, unchangedInput.EventID)
+
+	entries := queue.GetStatus(t.Context(), "session").Entries
+	edit(browser, ws.ActionMessageQueueSubmitUpdate, entries[1].ID, "human replacement", true)
+	edit(browser, ws.ActionMessageQueueUpdate, first.ID, "client replacement", false)
+	entries = queue.GetStatus(t.Context(), "session").Entries
+	envelope, err := messagequeue.BuildSendNowEnvelope(entries)
+	require.NoError(t, err)
+	input, ok := inputmeta.InputFromMetadata(envelope.Metadata, inputmeta.QueuedInputMetadataKey)
+	require.True(t, ok)
+	require.Equal(t, []string{"client", "human", "client"}, []string{input.Parts[0].Source, input.Parts[1].Source, input.Parts[2].Source})
+	require.Equal(t, "client replacement\n\nhuman replacement\n\ntoken request", input.Text)
+	require.NotEqual(t, firstInput.EventID, input.Parts[0].EventID)
+}
