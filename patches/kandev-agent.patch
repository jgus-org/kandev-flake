+			require.NoError(t, err)
+			session.State = models.TaskSessionStateRunning
+			require.NoError(t, repo.UpdateTaskSession(t.Context(), session))
+			advertisePromptQueueingForTest(t, svc, "session1")
+			started, release, done := make(chan inputmeta.Input, 1), make(chan struct{}), make(chan error, 1)
+			manager.cancelAgentFunc = func(ctx context.Context, _ string) error {
+				input, _ := inputmeta.InputFromContext(ctx)
+				started <- input
+				<-release
+				return errors.New("cancel transport failed")
+			}
+			go func() {
+				done <- svc.CancelAgent(inputmeta.WithInput(t.Context(), inputmeta.Input{Source: source}), "session1")
