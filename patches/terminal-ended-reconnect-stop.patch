+/**
+ * The http(s) twin of {@link buildTerminalWsUrl}. A browser cannot read the HTTP
+ * status of a failed WebSocket handshake, so the terminal client probes this URL
+ * to learn whether the target is permanently gone (410) rather than transiently
+ * not-ready (503). The backend short-circuits a non-upgrade GET to a readiness
+ * response, so this never disturbs a live terminal.
+ */
+export function buildTerminalProbeUrl(
+  wsBaseUrl: string,
+  params: Parameters<typeof buildTerminalWsUrl>[1],
+): string {
+  const httpBase = wsBaseUrl.replace(/^wss:/, "https:").replace(/^ws:/, "http:");
+  return buildTerminalWsUrl(httpBase, params);
+}
+
+/** True when the probe reports the terminal target is permanently gone. */
+export async function probeTerminalGone(probeUrl: string): Promise<boolean> {
+  const response = await fetch(probeUrl, {
+    method: "GET",
+    credentials: "same-origin",
+    headers: { Accept: "application/json" },
+  });
+  return response.status === 410;
+}
