diff --git a/apps/backend/internal/agent/runtime/lifecycle/manager_event_redaction.go b/apps/backend/internal/agent/runtime/lifecycle/manager_event_redaction.go
new file mode 100644
index 00000000..3fd856d5
--- /dev/null
+++ b/apps/backend/internal/agent/runtime/lifecycle/manager_event_redaction.go
@@ -0,0 +1,248 @@
+package lifecycle
+
+import (
+	"encoding/json"
+	"fmt"
+	"regexp"
+	"sort"
+	"strings"
+
+	agentctl "github.com/kandev/kandev/internal/agent/runtime/agentctl"
+	"github.com/kandev/kandev/internal/githubauth"
+)
+
+const agentEventCredentialMask = "<REDACTED:credential>"
+
+var (
+	agentEventEnvironmentAssignment = regexp.MustCompile(`(?m)([A-Za-z_][A-Za-z0-9_-]*)(\s*=\s*)[^\r\n]*`)
+	agentEventColonAssignment       = regexp.MustCompile(`(?m)([A-Za-z_][A-Za-z0-9_-]*)(\s*:\s*)[^\r\n]*`)
+	agentEventJSONAssignment        = regexp.MustCompile(`(?m)("([A-Za-z_][A-Za-z0-9_-]*)"\s*:\s*)"(?:\\.|[^"\r\n])*"`)
+	agentEventCredentialPatterns    = []*regexp.Regexp{
+		regexp.MustCompile(`(?s)-----BEGIN [A-Z][A-Z0-9 ]*-----.*?-----END [A-Z][A-Z0-9 ]*-----`),
+		regexp.MustCompile(`sk-(?:proj-|ant-|or-v1-)?[A-Za-z0-9_-]{20,}`),
+		regexp.MustCompile(`gh[pousr]_[A-Za-z0-9]{30,}`),
+		regexp.MustCompile(`github_pat_[A-Za-z0-9_]{20,}`),
+		regexp.MustCompile(`xox[abprs]-[A-Za-z0-9-]{10,}`),
+		regexp.MustCompile(`\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}`),
+		regexp.MustCompile(`tskey-[a-z]+-[A-Za-z0-9]{10,}-[A-Za-z0-9]+`),
+		regexp.MustCompile(`\bAKIA[0-9A-Z]{16}\b`),
+		regexp.MustCompile(`AGE-SECRET-KEY-1[A-Z0-9]{50,}`),
+	}
+)
+
+type agentEventRedactor struct {
+	names  map[string]struct{}
+	values []string
+}
+
+func newAgentEventRedactor(environment map[string]string) *agentEventRedactor {
+	redactor := &agentEventRedactor{names: map[string]struct{}{}}
+	for _, name := range []string{
+		"GH_TOKEN",
+		"GITHUB_TOKEN",
+		githubauth.CredentialLeaseEnv,
+		githubauth.CredentialReissueCapabilityEnv,
+		githubauth.CredentialScopesEnv,
+	} {
+		redactor.names[name] = struct{}{}
+	}
+
+	values := map[string]struct{}{}
+	for name, value := range environment {
+		if !redactor.isSensitiveName(name) {
+			continue
+		}
+		redactor.names[strings.ToUpper(name)] = struct{}{}
+		redactor.collectValue(values, value)
+	}
+	redactor.values = make([]string, 0, len(values))
+	for value := range values {
+		redactor.values = append(redactor.values, value)
+	}
+	sort.Slice(redactor.values, func(i, j int) bool {
+		return len(redactor.values[i]) > len(redactor.values[j])
+	})
+	return redactor
+}
+
+func (r *agentEventRedactor) collectValue(values map[string]struct{}, value string) {
+	if len(value) >= 8 {
+		values[value] = struct{}{}
+	}
+	var decoded any
+	if json.Unmarshal([]byte(value), &decoded) == nil {
+		r.collectJSONValues(values, decoded, false)
+	}
+}
+
+func (r *agentEventRedactor) collectJSONValues(values map[string]struct{}, value any, sensitive bool) {
+	switch typed := value.(type) {
+	case string:
+		if sensitive && len(typed) >= 8 {
+			values[typed] = struct{}{}
+		}
+	case []any:
+		for _, item := range typed {
+			r.collectJSONValues(values, item, sensitive)
+		}
+	case map[string]any:
+		for name, item := range typed {
+			r.collectJSONValues(values, item, sensitive || r.isSensitiveName(name))
+		}
+	}
+}
+
+func (r *agentEventRedactor) isSensitiveName(name string) bool {
+	normalized := strings.ToUpper(strings.ReplaceAll(name, "-", "_"))
+	if _, found := r.names[normalized]; found {
+		return true
+	}
+	for _, fragment := range []string{
+		"PASSWORD",
+		"PASSWD",
+		"SECRET",
+		"API_KEY",
+		"APIKEY",
+		"PRIVATE_KEY",
+		"ACCESS_KEY",
+		"SIGNING_KEY",
+		"ENCRYPTION_KEY",
+		"AUTHORIZATION",
+		"COOKIE",
+		"CREDENTIAL_LEASE",
+		"REISSUE_CAPABILITY",
+		"CREDENTIAL_SCOPES",
+	} {
+		if strings.Contains(normalized, fragment) {
+			return true
+		}
+	}
+	parts := strings.Split(normalized, "_")
+	switch parts[len(parts)-1] {
+	case "PASS", "PASSWORD", "PASSWD", "SECRET", "TOKEN", "CREDENTIAL", "CREDENTIALS":
+		return true
+	}
+	return normalized == "SSH_KEY" || normalized == "BASIC_AUTH" ||
+		normalized == "PAT" || strings.HasPrefix(normalized, "PAT_") ||
+		strings.HasSuffix(normalized, "_PAT") || strings.Contains(normalized, "_PAT_") ||
+		normalized == "LEASE"
+}
+
+func (r *agentEventRedactor) string(value string) string {
+	if redacted, ok := r.redactEmbeddedJSON(value); ok {
+		return redacted
+	}
+	for _, secret := range r.values {
+		value = strings.ReplaceAll(value, secret, agentEventCredentialMask)
+	}
+	for _, pattern := range agentEventCredentialPatterns {
+		value = pattern.ReplaceAllString(value, agentEventCredentialMask)
+	}
+	value = r.redactJSONAssignments(value)
+	value = r.redactTextAssignments(value, agentEventEnvironmentAssignment)
+	return r.redactTextAssignments(value, agentEventColonAssignment)
+}
+
+func (r *agentEventRedactor) redactEmbeddedJSON(value string) (string, bool) {
+	trimmed := strings.TrimSpace(value)
+	if len(trimmed) < 2 || trimmed[0] != '{' && trimmed[0] != '[' {
+		return "", false
+	}
+	var decoded any
+	if json.Unmarshal([]byte(trimmed), &decoded) != nil {
+		return "", false
+	}
+	encoded, err := json.Marshal(r.value(decoded))
+	if err != nil {
+		return "", false
+	}
+	return string(encoded), true
+}
+
+func (r *agentEventRedactor) redactTextAssignments(value string, pattern *regexp.Regexp) string {
+	return pattern.ReplaceAllStringFunc(value, func(match string) string {
+		parts := pattern.FindStringSubmatch(match)
+		if len(parts) != 3 || !r.isSensitiveName(parts[1]) {
+			return match
+		}
+		return parts[1] + parts[2] + agentEventCredentialMask
+	})
+}
+
+func (r *agentEventRedactor) redactJSONAssignments(value string) string {
+	return agentEventJSONAssignment.ReplaceAllStringFunc(value, func(match string) string {
+		parts := agentEventJSONAssignment.FindStringSubmatch(match)
+		if len(parts) != 3 || !r.isSensitiveName(parts[2]) {
+			return match
+		}
+		return parts[1] + `"` + agentEventCredentialMask + `"`
+	})
+}
+
+func (r *agentEventRedactor) value(value any) any {
+	switch typed := value.(type) {
+	case string:
+		return r.string(typed)
+	case []any:
+		for index, item := range typed {
+			typed[index] = r.value(item)
+		}
+	case map[string]any:
+		for name, item := range typed {
+			if r.isSensitiveName(name) {
+				typed[name] = r.sensitiveValue(item)
+				continue
+			}
+			typed[name] = r.value(item)
+		}
+	}
+	return value
+}
+
+func (r *agentEventRedactor) sensitiveValue(value any) any {
+	switch typed := value.(type) {
+	case string:
+		return agentEventCredentialMask
+	case []any:
+		for index, item := range typed {
+			typed[index] = r.sensitiveValue(item)
+		}
+	case map[string]any:
+		for name, item := range typed {
+			typed[name] = r.sensitiveValue(item)
+		}
+	}
+	return value
+}
+
+func redactAgentEvent(execution *AgentExecution, event agentctl.AgentEvent) (agentctl.AgentEvent, error) {
+	encoded, err := json.Marshal(event)
+	if err != nil {
+		return agentctl.AgentEvent{}, fmt.Errorf("encode agent event for credential redaction: %w", err)
+	}
+	var value any
+	if err := json.Unmarshal(encoded, &value); err != nil {
+		return agentctl.AgentEvent{}, fmt.Errorf("decode agent event for credential redaction: %w", err)
+	}
+	redactor := newAgentEventRedactor(execution.RuntimeEnvironment())
+	encoded, err = json.Marshal(redactor.value(value))
+	if err != nil {
+		return agentctl.AgentEvent{}, fmt.Errorf("encode redacted agent event: %w", err)
+	}
+	var redacted agentctl.AgentEvent
+	if err := json.Unmarshal(encoded, &redacted); err != nil {
+		return agentctl.AgentEvent{}, fmt.Errorf("decode redacted agent event: %w", err)
+	}
+	return redacted, nil
+}
+
+func credentialRedactionFailureEvent(event agentctl.AgentEvent) agentctl.AgentEvent {
+	return agentctl.AgentEvent{
+		Type:             "error",
+		SessionID:        event.SessionID,
+		OperationID:      event.OperationID,
+		PromptGeneration: event.PromptGeneration,
+		TurnID:           event.TurnID,
+		Error:            "agent event credential redaction failed",
+	}
+}
diff --git a/apps/backend/internal/agent/runtime/lifecycle/manager_event_redaction_test.go b/apps/backend/internal/agent/runtime/lifecycle/manager_event_redaction_test.go
new file mode 100644
index 00000000..09162877
--- /dev/null
+++ b/apps/backend/internal/agent/runtime/lifecycle/manager_event_redaction_test.go
@@ -0,0 +1,249 @@
+package lifecycle
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	agentctl "github.com/kandev/kandev/internal/agent/runtime/agentctl"
+	"github.com/kandev/kandev/internal/agentctl/types/streams"
+	"github.com/kandev/kandev/internal/githubauth"
+)
+
+func TestRedactAgentEventCredentials(t *testing.T) {
+	githubToken := "github_pat_11AA22BB33CC44DD55EE66FF77GG88HH99"
+	brokerResolvedGithubToken := "ghp_11AA22BB33CC44DD55EE66FF77GG88HH99"
+	primaryLease := "primary-lease-11AA22BB33CC44DD55EE66FF77GG88HH"
+	secondaryLease := "secondary-lease-11AA22BB33CC44DD55EE66FF77GG88"
+	reissueCapability := "reissue-capability-11AA22BB33CC44DD55EE66FF77GG"
+	scopes, err := json.Marshal([]map[string]string{
+		{"lease": primaryLease},
+		{"lease": secondaryLease},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	execution := &AgentExecution{}
+	execution.setRuntimeEnvironment(map[string]string{
+		"GH_TOKEN":                                githubToken,
+		githubauth.CredentialBrokerURLEnv:         "https://github.com/credential-broker",
+		githubauth.CredentialHelperPathEnv:        "/usr/bin/agentctl",
+		githubauth.CredentialLeaseEnv:             primaryLease,
+		githubauth.CredentialReissueCapabilityEnv: reissueCapability,
+		githubauth.CredentialTaskIDEnv:            "task-1",
+		githubauth.CredentialSessionIDEnv:         "session-1",
+		githubauth.CredentialRepositoryEnv:        "repository-1",
+		githubauth.CredentialOwnerEnv:             "org-1",
+		githubauth.CredentialRepoEnv:              "repo-1",
+		githubauth.CredentialHostEnv:              "github.com",
+		githubauth.CredentialScopesEnv:            string(scopes),
+	})
+	payload := streams.NewShellExec("env", "/workspace", "", 0, false)
+	payload.ShellExec().Output = &streams.ShellExecOutput{
+		Stdout: strings.Join([]string{
+			"SAFE=value",
+			brokerResolvedGithubToken,
+			"GH_TOKEN=" + githubToken,
+			githubauth.CredentialLeaseEnv + "=" + primaryLease,
+			githubauth.CredentialScopesEnv + "=" + string(scopes),
+			secondaryLease,
+		}, "\n"),
+	}
+	payload.SetBackgroundWorkIdentity(streams.BackgroundWorkKindShell, "work-1", true, false)
+	event := agentctl.AgentEvent{
+		Type:              streams.EventTypeToolUpdate,
+		SessionID:         "session-1",
+		ToolCallID:        "tool-1",
+		ToolStatus:        "completed",
+		NormalizedPayload: payload,
+		Text:              "task-1 session-1 repository-1 github.com org-1 repo-1 /usr/bin/agentctl credential " + reissueCapability,
+		Data: map[string]any{
+			"nested": map[string]any{
+				"password": githubToken,
+				"DB_PASS":  "database-password",
+				"SSH_KEY":  "ssh-key-material",
+			},
+			"json":        `{"GH_TOKEN":"` + githubToken + `","safe":"kept"}`,
+			"nested_json": `{"token":{"value":"opaque-random-value"},"safe":"kept"}`,
+		},
+	}
+
+	redacted, err := redactAgentEvent(execution, event)
+	if err != nil {
+		t.Fatal(err)
+	}
+	encoded, err := json.Marshal(redacted)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, secret := range []string{
+		githubToken,
+		brokerResolvedGithubToken,
+		primaryLease,
+		secondaryLease,
+		reissueCapability,
+		string(scopes),
+		"database-password",
+		"ssh-key-material",
+		"opaque-random-value",
+	} {
+		if strings.Contains(string(encoded), secret) {
+			t.Fatalf("redacted event contains credential")
+		}
+	}
+	if !strings.Contains(string(encoded), "SAFE=value") {
+		t.Fatalf("redacted event dropped non-credential output")
+	}
+	if !strings.Contains(string(encoded), strings.Trim(agentEventCredentialMask, "<>")) {
+		t.Fatalf("redacted event contains no credential mask")
+	}
+	if redacted.Type != event.Type || redacted.SessionID != event.SessionID || redacted.ToolCallID != event.ToolCallID {
+		t.Fatalf("redacted event dropped routing identity")
+	}
+	if !strings.Contains(redacted.Text, "task-1 session-1 repository-1 github.com org-1 repo-1 /usr/bin/agentctl") {
+		t.Fatalf("redacted event removed non-secret broker routing data")
+	}
+	redactedJSON, ok := redacted.Data["json"].(string)
+	if !ok || !json.Valid([]byte(redactedJSON)) {
+		t.Fatalf("redacted embedded JSON is invalid")
+	}
+	var redactedJSONObject map[string]string
+	if err := json.Unmarshal([]byte(redactedJSON), &redactedJSONObject); err != nil {
+		t.Fatal(err)
+	}
+	if redactedJSONObject["GH_TOKEN"] != agentEventCredentialMask || redactedJSONObject["safe"] != "kept" {
+		t.Fatalf("redacted embedded JSON lost structure")
+	}
+	redactedNestedJSON, ok := redacted.Data["nested_json"].(string)
+	if !ok || !json.Valid([]byte(redactedNestedJSON)) || !strings.Contains(redactedNestedJSON, `"safe":"kept"`) {
+		t.Fatalf("redacted nested JSON lost structure")
+	}
+	nested, ok := redacted.Data["nested"].(map[string]any)
+	if !ok || nested["DB_PASS"] != agentEventCredentialMask || nested["SSH_KEY"] != agentEventCredentialMask {
+		t.Fatalf("redacted event retained keyed credentials")
+	}
+	if redacted.NormalizedPayload == nil || !redacted.NormalizedPayload.IsActiveBackgroundWork() {
+		t.Fatalf("redacted event dropped background-work provenance")
+	}
+	idempotent, err := redactAgentEvent(execution, redacted)
+	if err != nil {
+		t.Fatal(err)
+	}
+	idempotentEncoded, err := json.Marshal(idempotent)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(idempotentEncoded) != string(encoded) {
+		t.Fatalf("credential redaction is not idempotent")
+	}
+}
+
+func TestRedactAgentEventPartialEnvironmentValue(t *testing.T) {
+	execution := &AgentExecution{}
+	execution.setRuntimeEnvironment(map[string]string{
+		githubauth.CredentialLeaseEnv: "complete-lease-value-11AA22BB33CC44DD55EE66FF",
+	})
+	payload := streams.NewShellExec("env", "", "", 0, false)
+	payload.ShellExec().Output = &streams.ShellExecOutput{
+		Stdout: githubauth.CredentialLeaseEnv + "=complete-lease-val",
+	}
+
+	redacted, err := redactAgentEvent(execution, agentctl.AgentEvent{
+		Type:              streams.EventTypeToolUpdate,
+		NormalizedPayload: payload,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdout := redacted.NormalizedPayload.ShellExec().Output.Stdout
+	if stdout != githubauth.CredentialLeaseEnv+"="+agentEventCredentialMask {
+		t.Fatalf("partial environment value was not redacted: %q", stdout)
+	}
+}
+
+func TestRedactAgentEventPreservesUsage(t *testing.T) {
+	execution := &AgentExecution{}
+	event := agentctl.AgentEvent{
+		Type: "complete",
+		Usage: &streams.PromptUsage{
+			InputTokens:         123,
+			OutputTokens:        45,
+			OutputTokensPresent: true,
+			CachedReadTokens:    67,
+			ThoughtTokens:       8,
+			TotalTokens:         243,
+		},
+	}
+
+	redacted, err := redactAgentEvent(execution, event)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if redacted.Usage == nil || *redacted.Usage != *event.Usage {
+		t.Fatalf("redacted event changed prompt usage")
+	}
+}
+
+func TestRedactAgentEventPreservesAuthenticationMethods(t *testing.T) {
+	execution := &AgentExecution{}
+	event := agentctl.AgentEvent{
+		Type: "agent_capabilities",
+		AuthMethods: []streams.AuthMethodInfo{
+			{
+				ID:          "chatgpt",
+				Name:        "ChatGPT",
+				Description: "Authenticate interactively",
+				TerminalAuth: &streams.TerminalAuth{
+					Command: "codex",
+					Args:    []string{"login", "--device-auth"},
+					Label:   "ChatGPT login",
+				},
+			},
+		},
+	}
+
+	redacted, err := redactAgentEvent(execution, event)
+	if err != nil {
+		t.Fatal(err)
+	}
+	original, err := json.Marshal(event.AuthMethods)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result, err := json.Marshal(redacted.AuthMethods)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(result) != string(original) {
+		t.Fatalf("redacted event changed authentication methods")
+	}
+}
+
+func TestRedactAgentEventFailureBecomesTerminalError(t *testing.T) {
+	event := agentctl.AgentEvent{
+		Type:             "complete",
+		SessionID:        "session-1",
+		OperationID:      "operation-1",
+		PromptGeneration: 2,
+		TurnID:           "turn-1",
+		Text:             "must not survive",
+		Data:             map[string]any{"secret": "must not survive"},
+	}
+
+	failed := credentialRedactionFailureEvent(event)
+	if failed.Type != "error" || failed.Error != "agent event credential redaction failed" {
+		t.Fatalf("redaction failure is not a terminal error")
+	}
+	if failed.SessionID != event.SessionID || failed.OperationID != event.OperationID ||
+		failed.PromptGeneration != event.PromptGeneration || failed.TurnID != event.TurnID {
+		t.Fatalf("redaction failure dropped prompt identity")
+	}
+	encoded, err := json.Marshal(failed)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Contains(string(encoded), "must not survive") {
+		t.Fatalf("redaction failure retained event content")
+	}
+}
