 			zap.Error(err))
 		return
 	}
+	if original.ACPSessionID == "" && original.McpMode != "office" {
+		prependEntryInstruction(prepared, result.EntryInstruction)
+	}
 	mergeSkillMetadata(prepared, result)
 }
 
+func prependEntryInstruction(prepared *LaunchRequest, entry *string) {
+	if entry == nil || *entry == "" {
+		return
+	}
+	if prepared.TaskDescription == "" {
+		prepared.TaskDescription = *entry
+	} else {
+		prepared.TaskDescription = *entry + "\n\n---\n\n" + prepared.TaskDescription
+	}
+	if prepared.Metadata == nil {
+		prepared.Metadata = make(map[string]interface{})
+	}
+	prepared.Metadata["task_description"] = prepared.TaskDescription
+}
+
 // mergeSkillMetadata applies the deployer's output to the prepared
 // launch request: every metadata patch is written through, and the
 // instructions directory is stamped under MetadataKeyInstructionsDir
