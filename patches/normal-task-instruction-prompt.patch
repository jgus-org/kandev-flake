+func TestRunSkillDeploy_FreshSessionPrependsEntryInstruction(t *testing.T) {
+	mgr := newSkillDeployTestManager(t)
+	entry := "# Managed instructions"
+	rec := &recordingDeployer{result: SkillDeployResult{EntryInstruction: &entry}}
+	mgr.skillDeployer = rec
+	mgr.agentProfileReader = &fakeProfileReader{profile: &settingsmodels.AgentProfile{ID: "p1", AgentID: "a1"}}
+	prepared := &LaunchRequest{TaskDescription: "User task"}
+
+	mgr.runSkillDeploy(context.Background(), &LaunchRequest{AgentProfileID: "p1"}, prepared)
+
+	if got, want := prepared.TaskDescription, "# Managed instructions\n\n---\n\nUser task"; got != want {
+		t.Fatalf("TaskDescription = %q, want %q", got, want)
+	}
+	if got, want := prepared.Metadata["task_description"], prepared.TaskDescription; got != want {
+		t.Fatalf("metadata task_description = %q, want %q", got, want)
+	}
+}
