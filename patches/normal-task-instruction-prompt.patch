+
+func effectiveEntryInstruction(manifest *Manifest, instructionsDir string) *string {
+	if manifest == nil {
+		return nil
+	}
+	for _, instruction := range manifest.Instructions {
+		if !instruction.IsEntry {
+			continue
+		}
+		content := instruction.Content
+		if instructionsDir != "" {
+			content = instructionrefs.Rewrite(content, instructionsDir)
+		}
+		return &content
+	}
+	return nil
+}
