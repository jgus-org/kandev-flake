 		return DeployResult{}, nil
 	}
 	result := d.deliver(ctx, manifest, req.ExecutorType, req.WorkspacePath)
+	result.EntryInstruction = effectiveEntryInstruction(manifest, result.InstructionsDir)
 	return result, nil
