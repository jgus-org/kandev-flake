@@ -0,0 +1,68 @@
+import { describe, expect, it } from "vitest";
+import type { AgentProfileOption } from "@/lib/state/slices";
+import type { AvailableAgent } from "@/lib/types/http";
+import {
+  buildTaskCreateModelOptions,
+  PROFILE_DEFAULT_MODEL,
+  withSelectedConfigOptions,
+} from "./task-create-model-selector";
+
+const profile = {
+  id: "profile-1",
+  label: "Codex",
+  agent_id: "agent-1",
+  agent_name: "codex",
+  cli_passthrough: false,
+  model: "model-1",
+} satisfies AgentProfileOption;
+
+const availableAgent = {
+  name: "codex",
+  model_config: {
+    available_models: [
+      { id: "model-1", name: "Model One" },
+      { id: "model-2", name: "Model Two" },
+    ],
+  },
+} as AvailableAgent;
+
+describe("withSelectedConfigOptions", () => {
+  const configOptions = [
+    { type: "select", id: "model", name: "Model", currentValue: "model-1" },
+    { type: "select", id: "reasoning_effort", name: "Reasoning effort", currentValue: "medium" },
+  ];
+
+  it("returns provider options unchanged without selections", () => {
+    expect(withSelectedConfigOptions(configOptions, {})).toBe(configOptions);
+  });
+
+  it("overlays only the selected option values", () => {
+    expect(withSelectedConfigOptions(configOptions, { reasoning_effort: "high" })).toEqual([
+      { type: "select", id: "model", name: "Model", currentValue: "model-1" },
+      { type: "select", id: "reasoning_effort", name: "Reasoning effort", currentValue: "high" },
+    ]);
+  });
+});
+
+describe("buildTaskCreateModelOptions", () => {
+  it("offers profile inheritance before advertised models", () => {
+    expect(
+      buildTaskCreateModelOptions(profile, [availableAgent], "default", "Agent default"),
+    ).toEqual([
+      { id: PROFILE_DEFAULT_MODEL, name: "Model One (default)" },
+      { id: "model-1", name: "Model One", description: "model-1" },
+      { id: "model-2", name: "Model Two", description: "model-2" },
+    ]);
+  });
+
+  it("uses the agent default when the profile has no configured model", () => {
+    expect(
+      buildTaskCreateModelOptions(
+        { ...profile, model: undefined },
+        [availableAgent],
+        "default",
+        "Agent default",
+      )[0],
+    ).toEqual({ id: PROFILE_DEFAULT_MODEL, name: "Agent default" });
+  });
+});
diff --git a/web/components/task-create-model-selector.tsx b/web/components/task-create-model-selector.tsx
new file mode 100644
index 0000000..fc63e4e
--- /dev/null
+++ b/web/components/task-create-model-selector.tsx
@@ -0,0 +1,105 @@
+"use client";
+
+import { useMemo } from "react";
+import { useTranslation } from "react-i18next";
+import {
+  ModelConfigSelector,
+  type DynamicConfigOption,
+  type ModelSelectorOption,
+} from "@/components/model-config-selector";
+import { useAvailableAgents } from "@/hooks/domains/settings/use-available-agents";
+import { useResolvedModelConfig } from "@/hooks/domains/settings/use-dynamic-models";
+import type { AgentProfileOption } from "@/lib/state/slices";
+import type { AvailableAgent } from "@/lib/types/http";
+
+export const PROFILE_DEFAULT_MODEL = "__kandev_profile_default__";
+
+export function buildTaskCreateModelOptions(
+  profile: AgentProfileOption | undefined,
+  availableAgents: AvailableAgent[],
+  defaultLabel: string,
+  agentDefaultLabel: string,
+): ModelSelectorOption[] {
+  if (!profile) return [];
+  const catalog = availableAgents.find((agent) => agent.name === profile.agent_name)?.model_config;
+  const models = catalog?.available_models ?? [];
+  const configured = models.find((model) => model.id === profile.model);
+  const inheritedName = profile.model
+    ? `${configured?.name ?? profile.model} (${defaultLabel})`
+    : agentDefaultLabel;
+  return [
+    { id: PROFILE_DEFAULT_MODEL, name: inheritedName },
+    ...models.map((model) => ({
+      id: model.id,
+      name: model.name,
+      description: model.description ?? (model.id !== model.name ? model.id : undefined),
+    })),
+  ];
+}
+
+export function withSelectedConfigOptions(
+  configOptions: DynamicConfigOption[],
+  selected: Record<string, string>,
+): DynamicConfigOption[] {
+  if (Object.keys(selected).length === 0) return configOptions;
+  return configOptions.map((option) =>
+    option.id in selected ? { ...option, currentValue: selected[option.id] } : option,
+  );
+}
+
+type TaskCreateModelSelectorProps = {
+  agentProfiles: AgentProfileOption[];
+  agentProfileId: string;
+  value: string;
+  onValueChange: (value: string) => void;
+  configOptionsValue?: Record<string, string>;
+  onConfigOptionChange?: (configId: string, value: string) => void;
+  disabled?: boolean;
+};
+
+export function TaskCreateModelSelector({
+  agentProfiles,
+  agentProfileId,
+  value,
+  onValueChange,
+  configOptionsValue,
+  onConfigOptionChange,
+  disabled,
+}: TaskCreateModelSelectorProps) {
+  const { t } = useTranslation();
+  const availableAgents = useAvailableAgents();
+  const profile = agentProfiles.find((item) => item.id === agentProfileId);
+  const modelOptions = useMemo(
+    () =>
+      buildTaskCreateModelOptions(
+        profile,
+        availableAgents.items,
+        t("common:default"),
+        t("task:modelSelectionProviderDefault"),
+      ),
+    [availableAgents.items, profile, t],
+  );
+  const resolvedModel = value || profile?.model;
+  const { configOptions, isLoading } = useResolvedModelConfig(
+    profile?.agent_name,
+    resolvedModel || undefined,
+    { enabled: !!profile },
+  );
+  const selectConfigOptions = useMemo(
+    () => withSelectedConfigOptions(configOptions, configOptionsValue ?? {}),
+    [configOptions, configOptionsValue],
+  );
+  const hasSelectableModel = modelOptions.length > 1;
+  return (
+    <ModelConfigSelector
+      modelOptions={modelOptions}
+      currentModel={value || PROFILE_DEFAULT_MODEL}
+      configOptions={selectConfigOptions}
+      onModelChange={(model) => onValueChange(model === PROFILE_DEFAULT_MODEL ? "" : model)}
+      onConfigChange={onConfigOptionChange}
+      configOptionsLoading={isLoading}
+      disabled={disabled || availableAgents.loading || !profile || !hasSelectableModel}
+      popoverAlign="start"
+    />
+  );
+}
