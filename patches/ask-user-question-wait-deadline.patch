+// silentAskBackend never answers a question bundle: it waits for the caller's own
+// deadline and records the clarification-timeout notification that must follow.
+type silentAskBackend struct {
+	clarificationTimeout chan string
+}
+
+func (b *silentAskBackend) RequestPayload(ctx context.Context, action string, _, _ interface{}) error {
+	switch action {
+	case ws.ActionMCPAskUserQuestion:
+		<-ctx.Done()
+		return ctx.Err()
+	case ws.ActionMCPClarificationTimeout:
+		b.clarificationTimeout <- action
+	}
+	return nil
+}
+
+// TestAskUserQuestion_ExpiresInsideTheClientDeadline covers the case where nobody
+// answers: the tool call must finish on Kandev's clock with every question
+// unanswered, and the pending question must be handed to the clarification-timeout
+// path so a late answer still reaches the agent. Letting the agent's MCP client
+// abort the in-flight call instead tears the tool down while its server is still
+// registered, which is how a session loses the Kandev tools permanently.
+func TestAskUserQuestion_ExpiresInsideTheClientDeadline(t *testing.T) {
+	backend := &silentAskBackend{clarificationTimeout: make(chan string)}
+	s := newTaskModeServer(t, backend, "task-current")
+
+	prev := askQuestionMaxWait
+	askQuestionMaxWait = time.Minute
+	t.Cleanup(func() { askQuestionMaxWait = prev })
+
+	args := map[string]interface{}{
+		"questions": []map[string]interface{}{
+			{
+				"id":     "q1",
+				"prompt": "Which?",
+				"options": []map[string]interface{}{
+					{"label": "Yes", "description": "y"},
+					{"label": "No", "description": "n"},
+				},
+			},
+		},
+	}
+
+	var result *mcplib.CallToolResult
+	synctest.Test(t, func(t *testing.T) {
+		result = callTool(t, s, "ask_user_question_kandev", args)
+		assert.Equal(t, ws.ActionMCPClarificationTimeout, <-backend.clarificationTimeout)
+	})
+
+	require.False(t, result.IsError, "an unanswered question must complete the call, not abort it")
+	textBlock, ok := result.Content[0].(mcplib.TextContent)
+	require.True(t, ok)
+	var parsed map[string]interface{}
+	require.NoError(t, json.Unmarshal([]byte(textBlock.Text), &parsed))
+	assert.Equal(t, true, parsed[timedOutFieldKey])
+	assert.Equal(t, false, parsed["q1"].(map[string]interface{})[answeredFieldKey])
+}
