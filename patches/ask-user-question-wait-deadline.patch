+// clarificationTimedOut answers a question bundle that nobody replied to inside
+// askQuestionMaxWait. The result keeps the shape the agent already parses, with
+// every question reported unanswered, so the tool call finishes instead of being
+// aborted by the agent's client.
+func clarificationTimedOut(questions []map[string]interface{}) *mcp.CallToolResult {
+	out := make(map[string]interface{}, len(questions)+1)
+	out[timedOutFieldKey] = true
+	for _, q := range questions {
+		qid, _ := q[idArg].(string)
+		if qid == "" {
+			continue
+		}
+		out[qid] = map[string]interface{}{answeredFieldKey: false}
+	}
+	data, _ := json.MarshalIndent(out, "", "  ")
+	return mcp.NewToolResultStructured(out, string(data))
+}
