+type managedReferences struct {
+	secrets       map[string]string
+	agentProfiles map[string]string
+}
+
+func applyManagedConfiguration(
+	ctx context.Context,
+	cfg *config.Config,
+	log *logger.Logger,
+	repos *Repositories,
+	services *Services,
+	agents *agentsettingscontroller.Controller,
+) error {
+	managed := cfg.Managed
+	if reflect.DeepEqual(managed, config.ManagedConfig{}) {
+		return nil
+	}
+	refs := &managedReferences{
+		secrets:       make(map[string]string),
+		agentProfiles: make(map[string]string),
+	}
+	if err := applyManagedPlugins(ctx, services, managed.Plugins); err != nil {
+		return err
+	}
+	if err := applyManagedSecrets(ctx, log, repos, managed.Secrets, refs); err != nil {
+		return err
+	}
+	if err := applyManagedAgents(ctx, agents, repos.Office, managed.Agents, refs); err != nil {
+		return err
+	}
+	if err := applyManagedExecutors(ctx, services, managed.Executors, refs); err != nil {
+		return err
+	}
+	for _, workspace := range managed.Workspaces {
+		if err := applyManagedWorkspace(ctx, repos, services, workspace, refs); err != nil {
+			return fmt.Errorf("managed workspace %q: %w", workspace.Name, err)
+		}
+	}
+	return nil
+}
+
+type managedInstructionStore interface {
+	UpsertInstruction(ctx context.Context, agentProfileID, filename, content string, isEntry bool) error
+}
+
+func reconcileManagedProfileInstructions(
+	ctx context.Context,
+	store managedInstructionStore,
+	agentProfileID string,
+	instructions *string,
+) error {
+	if instructions == nil {
+		return nil
+	}
+	return store.UpsertInstruction(ctx, agentProfileID, "AGENTS.md", *instructions, true)
+}
+
+func applyManagedPlugins(ctx context.Context, services *Services, desired []config.ManagedPlugin) error {
+	if len(desired) > 0 && services.Plugins == nil {
+		return fmt.Errorf("plugin service is unavailable")
+	}
+	for _, plugin := range desired {
+		current, err := services.Plugins.Get(plugin.ID)
+		if err != nil && !errors.Is(err, pluginstore.ErrNotFound) {
+			return fmt.Errorf("read plugin %q: %w", plugin.ID, err)
+		}
+		if errors.Is(err, pluginstore.ErrNotFound) || current.Version != plugin.Version {
+			file, openErr := os.Open(plugin.PackageFile)
+			if openErr != nil {
+				return fmt.Errorf("open plugin package %q: %w", plugin.PackageFile, openErr)
+			}
+			_, installErr := services.Plugins.Install(ctx, file)
+			closeErr := file.Close()
+			if installErr != nil {
+				return fmt.Errorf("install plugin %q: %w", plugin.ID, installErr)
+			}
+			if closeErr != nil {
+				return fmt.Errorf("close plugin package %q: %w", plugin.PackageFile, closeErr)
+			}
+		}
+		if err := services.Plugins.Enable(plugin.ID); err != nil {
+			return fmt.Errorf("enable plugin %q: %w", plugin.ID, err)
+		}
+	}
+	return nil
+}
+
+func applyManagedSecrets(
+	ctx context.Context,
+	log *logger.Logger,
+	repos *Repositories,
+	desired []config.ManagedSecret,
+	refs *managedReferences,
+) error {
+	service := secrets.NewService(repos.Secrets, log)
+	existing, err := service.ListScoped(ctx, secrets.SecretListOptions{Scope: secrets.ScopeGlobal})
+	if err != nil {
+		return fmt.Errorf("list managed secrets: %w", err)
+	}
+	for _, item := range desired {
+		value, err := readManagedSecret(item.ValueFile)
+		if err != nil {
+			return err
+		}
+		matches := make([]*secrets.SecretListItem, 0, 1)
+		for index := range existing {
+			if existing[index].Name == item.Name {
+				matches = append(matches, existing[index])
+			}
+		}
+		if len(matches) > 1 {
+			return fmt.Errorf("multiple global secrets are named %q", item.Name)
+		}
+		if len(matches) == 0 {
+			created, err := service.Create(ctx, &secrets.CreateSecretRequest{Name: item.Name, Value: value, Scope: secrets.ScopeGlobal})
+			if err != nil {
+				return fmt.Errorf("create secret %q: %w", item.Name, err)
+			}
+			refs.secrets[item.Name] = created.ID
+			continue
+		}
+		current, err := service.Reveal(ctx, matches[0].ID)
+		if err != nil {
+			return fmt.Errorf("read secret %q: %w", item.Name, err)
+		}
+		if current != value {
+			if _, err := service.Update(ctx, matches[0].ID, &secrets.UpdateSecretRequest{Value: &value}); err != nil {
+				return fmt.Errorf("update secret %q: %w", item.Name, err)
+			}
+		}
+		refs.secrets[item.Name] = matches[0].ID
+	}
+	return nil
+}
+
+func applyManagedAgents(
+	ctx context.Context,
+	controller *agentsettingscontroller.Controller,
+	instructions managedInstructionStore,
+	desired []config.ManagedAgent,
+	refs *managedReferences,
+) error {
+	response, err := controller.ListAgents(ctx)
+	if err != nil {
+		return fmt.Errorf("list agents: %w", err)
+	}
+	for _, configuredAgent := range desired {
+		var agent *agentsettingsdto.AgentDTO
+		for index := range response.Agents {
+			if response.Agents[index].Name == configuredAgent.Name {
+				agent = &response.Agents[index]
+				break
+			}
+		}
+		if agent == nil {
+			created, err := controller.CreateAgent(ctx, agentsettingscontroller.CreateAgentRequest{Name: configuredAgent.Name})
+			if err != nil {
+				return fmt.Errorf("create agent %q: %w", configuredAgent.Name, err)
+			}
+			agent = created
+		}
+		for _, configuredProfile := range configuredAgent.Profiles {
+			environment, err := managedAgentEnvironment(configuredProfile.Environment, refs.secrets)
+			if err != nil {
+				return fmt.Errorf("agent profile %q/%q: %w", configuredAgent.Name, configuredProfile.Name, err)
+			}
+			var current *agentsettingsdto.AgentProfileDTO
+			for index := range agent.Profiles {
+				if agent.Profiles[index].Name == configuredProfile.Name {
+					current = &agent.Profiles[index]
+					break
+				}
+			}
+			if current == nil {
+				created, err := controller.CreateProfile(ctx, agentsettingscontroller.CreateProfileRequest{
+					AgentID: agent.ID, Name: configuredProfile.Name, Model: configuredProfile.Model,
+					FallbackModel: configuredProfile.FallbackModel, AutoFallback: configuredProfile.AutoFallback,
+					AllowIndexing: configuredProfile.AllowIndexing, AutoApprove: configuredProfile.AutoApprove,
+					CLIPassthrough: configuredProfile.CLIPassthrough, EnvVars: environment,
+				})
+				if err != nil {
+					return fmt.Errorf("create agent profile %q/%q: %w", configuredAgent.Name, configuredProfile.Name, err)
+				}
+				current = created
+			} else {
+				name := configuredProfile.Name
+				model := configuredProfile.Model
+				fallbackModel := configuredProfile.FallbackModel
+				autoFallback := configuredProfile.AutoFallback
+				allowIndexing := configuredProfile.AllowIndexing
+				autoApprove := configuredProfile.AutoApprove
+				cliPassthrough := configuredProfile.CLIPassthrough
+				enabled := configuredProfile.Enabled
+				updated, err := controller.UpdateProfile(ctx, agentsettingscontroller.UpdateProfileRequest{
+					ID: current.ID, Name: &name, Model: &model, FallbackModel: &fallbackModel,
+					AutoFallback: &autoFallback, AllowIndexing: &allowIndexing, AutoApprove: &autoApprove,
+					CLIPassthrough: &cliPassthrough, Enabled: &enabled, EnvVars: &environment, Force: true,
+				})
+				if err != nil {
+					return fmt.Errorf("update agent profile %q/%q: %w", configuredAgent.Name, configuredProfile.Name, err)
+				}
+				current = updated
+			}
+			if err := reconcileManagedProfileInstructions(ctx, instructions, current.ID, configuredProfile.Instructions); err != nil {
+				return fmt.Errorf("reconcile instructions for agent profile %q/%q: %w", configuredAgent.Name, configuredProfile.Name, err)
+			}
+			refs.agentProfiles[configuredAgent.Name+"/"+configuredProfile.Name] = current.ID
+		}
+	}
+	return nil
+}
+
+func applyManagedExecutors(
+	ctx context.Context,
+	services *Services,
+	desired []config.ManagedExecutor,
+	refs *managedReferences,
+) error {
+	executors, err := services.Task.ListExecutors(ctx)
+	if err != nil {
+		return fmt.Errorf("list executors: %w", err)
+	}
+	for _, configured := range desired {
+		executorConfig := cloneStringMap(configured.Config)
+		if configured.SSHHostPublicKey != "" {
+			algorithm, fingerprint, err := parseSSHHostPublicKey(configured.SSHHostPublicKey)
+			if err != nil {
+				return fmt.Errorf("executor %q: %w", configured.Name, err)
+			}
+			executorConfig["ssh_host_key_algorithm"] = algorithm
+			executorConfig["ssh_host_fingerprint"] = fingerprint
+		}
+		var executor *taskmodels.Executor
+		for _, candidate := range executors {
+			if candidate.Name == configured.Name {
+				executor = candidate
+				break
+			}
+		}
+		if executor == nil {
+			created, err := services.Task.CreateExecutor(ctx, &taskservice.CreateExecutorRequest{
+				Name: configured.Name, Type: taskmodels.ExecutorType(configured.Type),
+				Status: taskmodels.ExecutorStatus(configured.Status), Resumable: configured.Resumable, Config: executorConfig,
+			})
+			if err != nil {
+				return fmt.Errorf("create executor %q: %w", configured.Name, err)
+			}
+			executor = created
+		} else {
+			name := configured.Name
+			typeName := taskmodels.ExecutorType(configured.Type)
+			status := taskmodels.ExecutorStatus(configured.Status)
+			resumable := configured.Resumable
+			updated, err := services.Task.UpdateExecutor(ctx, executor.ID, &taskservice.UpdateExecutorRequest{
+				Name: &name, Type: &typeName, Status: &status, Resumable: &resumable, Config: executorConfig,
+			})
+			if err != nil {
+				return fmt.Errorf("update executor %q: %w", configured.Name, err)
+			}
+			executor = updated
+		}
+		profiles, err := services.Task.ListExecutorProfiles(ctx, executor.ID)
+		if err != nil {
+			return fmt.Errorf("list executor profiles for %q: %w", configured.Name, err)
+		}
+		for _, configuredProfile := range configured.Profiles {
+			environment, err := managedExecutorEnvironment(configuredProfile.Environment, refs.secrets)
+			if err != nil {
+				return fmt.Errorf("executor profile %q/%q: %w", configured.Name, configuredProfile.Name, err)
+			}
+			prepareScript := configuredProfile.PrepareScript
+			if prepareScript == "default" {
+				prepareScript = agentlifecycle.DefaultPrepareScript(configured.Type)
+			}
+			var profile *taskmodels.ExecutorProfile
+			for _, candidate := range profiles {
+				if candidate.Name == configuredProfile.Name {
+					profile = candidate
+					break
+				}
+			}
+			if profile == nil {
+				created, err := services.Task.CreateExecutorProfile(ctx, &taskservice.CreateExecutorProfileRequest{
+					ExecutorID: executor.ID, Name: configuredProfile.Name, McpPolicy: configuredProfile.MCPPolicy,
+					Config: configuredProfile.Config, PrepareScript: prepareScript,
+					CleanupScript: configuredProfile.CleanupScript, EnvVars: environment,
+				})
+				if err != nil {
+					return fmt.Errorf("create executor profile %q/%q: %w", configured.Name, configuredProfile.Name, err)
+				}
+				profile = created
+			} else {
+				name := configuredProfile.Name
+				mcpPolicy := configuredProfile.MCPPolicy
+				cleanupScript := configuredProfile.CleanupScript
+				updated, err := services.Task.UpdateExecutorProfile(ctx, profile.ID, &taskservice.UpdateExecutorProfileRequest{
+					Name: &name, McpPolicy: &mcpPolicy, Config: configuredProfile.Config,
+					PrepareScript: &prepareScript, CleanupScript: &cleanupScript, EnvVars: environment,
+				})
+				if err != nil {
+					return fmt.Errorf("update executor profile %q/%q: %w", configured.Name, configuredProfile.Name, err)
+				}
+				profile = updated
+			}
+		}
+	}
+	return nil
+}
+
+func applyManagedWorkspace(
+	ctx context.Context,
+	repos *Repositories,
+	services *Services,
+	desired config.ManagedWorkspace,
+	refs *managedReferences,
+) error {
+	workspaces, err := services.Task.ListWorkspaces(ctx)
+	if err != nil {
+		return err
+	}
+	var workspace *taskmodels.Workspace
+	for _, candidate := range workspaces {
+		if candidate.Name == desired.Name {
+			if workspace != nil {
+				return fmt.Errorf("multiple workspaces are named %q", desired.Name)
+			}
+			workspace = candidate
+		}
+	}
+	if workspace == nil {
+		return fmt.Errorf("workspace does not exist")
+	}
+	for _, workflow := range desired.Workflows {
+		if err := applyManagedWorkflow(ctx, services, workspace.ID, workflow, refs); err != nil {
+			return err
+		}
+	}
+	if desired.DefaultAgentProfile != "" {
+		profileID, ok := refs.agentProfiles[desired.DefaultAgentProfile]
+		if !ok {
+			return fmt.Errorf("agent profile %q is not managed", desired.DefaultAgentProfile)
+		}
+		if _, err := services.Task.UpdateWorkspace(ctx, workspace.ID, &taskservice.UpdateWorkspaceRequest{DefaultAgentProfileID: &profileID}); err != nil {
+			return err
+		}
+	}
+	if desired.BranchPrefix != "" || desired.BranchTemplate != "" {
+		if err := services.Task.SetRepositoryBranchDefaults(workspace.ID, desired.BranchPrefix, desired.BranchTemplate); err != nil {
+			return err
+		}
+		repositories, err := services.Task.ListRepositories(ctx, workspace.ID)
+		if err != nil {
+			return err
+		}
+		for _, repository := range repositories {
+			if _, err := services.Task.UpdateRepository(ctx, repository.ID, &taskservice.UpdateRepositoryRequest{
+				WorktreeBranchPrefix: &desired.BranchPrefix, WorktreeBranchTemplate: &desired.BranchTemplate,
+			}); err != nil {
+				return fmt.Errorf("update repository %q branches: %w", repository.Name, err)
+			}
+		}
+	}
+	if desired.GitHub != nil {
+		if err := applyManagedGitHub(ctx, repos, services, workspace.ID, *desired.GitHub); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func applyManagedWorkflow(
+	ctx context.Context,
+	services *Services,
+	workspaceID string,
+	desired config.ManagedWorkflow,
+	refs *managedReferences,
+) error {
+	workflows, err := services.Task.ListWorkflows(ctx, workspaceID, true)
+	if err != nil {
+		return err
+	}
+	var workflow *taskmodels.Workflow
+	for _, candidate := range workflows {
+		if candidate.Name == desired.Name {
+			if workflow != nil {
+				return fmt.Errorf("multiple workflows are named %q", desired.Name)
+			}
+			workflow = candidate
+		}
+	}
+	profileID := ""
+	if desired.AgentProfile != "" {
+		var ok bool
+		profileID, ok = refs.agentProfiles[desired.AgentProfile]
+		if !ok {
+			return fmt.Errorf("agent profile %q is not managed", desired.AgentProfile)
+		}
+	}
+	if workflow == nil {
+		created, err := services.Task.CreateWorkflow(ctx, &taskservice.CreateWorkflowRequest{
+			WorkspaceID: workspaceID, Name: desired.Name, Description: desired.Description, Prompt: desired.Prompt,
+		})
+		if err != nil {
+			return fmt.Errorf("create workflow %q: %w", desired.Name, err)
+		}
+		workflow = created
+	}
+	if _, err := services.Task.UpdateWorkflow(ctx, workflow.ID, &taskservice.UpdateWorkflowRequest{
+		Name: &desired.Name, Description: &desired.Description, Prompt: &desired.Prompt, AgentProfileID: &profileID,
+	}); err != nil {
+		return fmt.Errorf("update workflow %q: %w", desired.Name, err)
+	}
+	steps, err := services.Workflow.ListStepsByWorkflow(ctx, workflow.ID)
+	if err != nil {
+		return err
+	}
+	for position, desiredStep := range desired.Steps {
+		var step *workflowmodels.WorkflowStep
+		for _, candidate := range steps {
+			if candidate.Name == desiredStep.Name {
+				if step != nil {
+					return fmt.Errorf("multiple workflow steps are named %q", desiredStep.Name)
+				}
+				step = candidate
+			}
+		}
+		events, err := decodeManagedStepEvents(desiredStep.Events)
+		if err != nil {
+			return fmt.Errorf("workflow step %q: %w", desiredStep.Name, err)
+		}
+		if step == nil {
+			step = &workflowmodels.WorkflowStep{WorkflowID: workflow.ID}
+		}
+		step.Name = desiredStep.Name
+		step.Position = position * 100
+		step.Color = desiredStep.Color
+		step.Prompt = desiredStep.Prompt
+		step.Events = events
+		step.AllowManualMove = desiredStep.AllowManualMove
+		step.IsStartStep = desiredStep.IsStartStep
+		step.ShowInCommandPanel = desiredStep.ShowInCommandPanel
+		step.StageType = workflowmodels.StageType(desiredStep.StageType)
+		if step.ID == "" {
+			if err := services.Workflow.CreateStep(ctx, step); err != nil {
+				return err
+			}
+		} else if err := services.Workflow.UpdateStep(ctx, step); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func applyManagedGitHub(
+	ctx context.Context,
+	repos *Repositories,
+	services *Services,
+	workspaceID string,
+	desired config.ManagedGitHub,
+) error {
+	token, err := readManagedSecret(desired.TokenFile)
+	if err != nil {
+		return err
+	}
+	storedToken, _ := repos.Secrets.Reveal(ctx, github.WorkspacePATSecretKey(workspaceID))
+	status, statusErr := services.GitHub.GetWorkspaceAuthStatus(ctx, workspaceID, "")
+	if statusErr != nil || status.AuthMethod != string(github.ConnectionSourcePAT) || storedToken != token {
+		if _, err := services.GitHub.SetWorkspaceConnection(ctx, workspaceID, github.SetWorkspaceConnectionRequest{
+			Source: github.ConnectionSourcePAT, Token: token,
+		}); err != nil {
+			return fmt.Errorf("configure GitHub connection: %w", err)
+		}
+	}
+	if _, err := services.GitHub.UpdateWorkspaceSettings(ctx, &github.UpdateWorkspaceSettingsRequest{
+		WorkspaceID: workspaceID, TaskGitCredentialsMode: &desired.TaskCredentialsMode,
+		RepoScopeMode: &desired.RepositoryScopeMode,
+	}); err != nil {
+		return fmt.Errorf("configure GitHub workspace: %w", err)
+	}
+	watches, err := services.GitHub.ListIssueWatches(ctx, workspaceID)
+	if err != nil {
+		return fmt.Errorf("list obsolete GitHub issue watches: %w", err)
+	}
+	for _, watch := range watches {
+		if err := services.GitHub.DeleteIssueWatch(ctx, watch.ID); err != nil {
+			return fmt.Errorf("delete obsolete GitHub issue watch %q: %w", watch.ID, err)
+		}
+	}
+	return nil
+}
+
+func readManagedSecret(path string) (string, error) {
+	value, err := os.ReadFile(path)
+	if err != nil {
+		return "", fmt.Errorf("read managed secret %q: %w", path, err)
+	}
+	trimmed := strings.TrimSpace(string(value))
+	if trimmed == "" {
+		return "", fmt.Errorf("managed secret file %q is empty", path)
+	}
+	return trimmed, nil
+}
+
+func managedAgentEnvironment(values []config.ManagedEnvironment, secretIDs map[string]string) ([]agentsettingsdto.ProfileEnvVarDTO, error) {
+	result := make([]agentsettingsdto.ProfileEnvVarDTO, len(values))
+	for index, value := range values {
+		secretID, err := resolveManagedSecret(value.Secret, secretIDs)
+		if err != nil {
+			return nil, err
+		}
+		result[index] = agentsettingsdto.ProfileEnvVarDTO{Key: value.Key, Value: value.Value, SecretID: secretID}
+	}
+	return result, nil
+}
+
+func managedExecutorEnvironment(values []config.ManagedEnvironment, secretIDs map[string]string) ([]taskmodels.ProfileEnvVar, error) {
+	result := make([]taskmodels.ProfileEnvVar, len(values))
+	for index, value := range values {
+		secretID, err := resolveManagedSecret(value.Secret, secretIDs)
+		if err != nil {
+			return nil, err
+		}
+		result[index] = taskmodels.ProfileEnvVar{Key: value.Key, Value: value.Value, SecretID: secretID}
+	}
+	return result, nil
+}
+
+func resolveManagedSecret(name string, secretIDs map[string]string) (string, error) {
+	if name == "" {
+		return "", nil
+	}
+	id, ok := secretIDs[name]
+	if !ok {
+		return "", fmt.Errorf("secret %q is not managed", name)
+	}
+	return id, nil
+}
+
+func parseSSHHostPublicKey(publicKey string) (string, string, error) {
+	key, _, _, _, err := ssh.ParseAuthorizedKey([]byte(publicKey))
+	if err != nil {
+		return "", "", fmt.Errorf("SSH host public key is malformed: %w", err)
+	}
+	return key.Type(), ssh.FingerprintSHA256(key), nil
+}
+
+func decodeManagedStepEvents(value map[string]any) (workflowmodels.StepEvents, error) {
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		return workflowmodels.StepEvents{}, err
+	}
+	var events workflowmodels.StepEvents
+	if err := json.Unmarshal(encoded, &events); err != nil {
+		return workflowmodels.StepEvents{}, err
+	}
+	return events, nil
+}
+
+func cloneStringMap(source map[string]string) map[string]string {
+	result := make(map[string]string, len(source)+1)
+	for key, value := range source {
+		result[key] = value
+	}
+	return result
+}
