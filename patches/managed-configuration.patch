@@ -0,0 +1,60 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestManagedConfigFromFile(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.yaml")
+	contents := `{
+		"managed": {
+			"plugins": [{"id": "resource-coordinator", "version": "0.2.0", "packageFile": "/package.tar.gz"}],
+			"agents": [{"name": "codex-acp", "profiles": [
+				{"name": "managed", "instructions": ""},
+				{"name": "unmanaged"}
+			]}],
+			"executors": [{
+				"name": "executor-1",
+				"type": "ssh",
+				"sshHostPublicKey": "ssh-ed25519 AAAA",
+				"profiles": [{"name": "executor-1", "prepareScript": "default"}]
+			}],
+			"workspaces": [{
+				"name": "Default Workspace",
+				"github": {
+					"taskCredentialsMode": "executor",
+					"repositoryScopeMode": "all"
+				}
+			}]
+		}
+	}`
+	if err := os.WriteFile(path, []byte(contents), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := LoadWithPath(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(cfg.Managed.Plugins) != 1 || cfg.Managed.Plugins[0].PackageFile != "/package.tar.gz" {
+		t.Fatalf("managed plugins = %#v", cfg.Managed.Plugins)
+	}
+	profiles := cfg.Managed.Agents[0].Profiles
+	if profiles[0].Instructions == nil || *profiles[0].Instructions != "" {
+		t.Fatalf("explicit empty instructions = %#v", profiles[0].Instructions)
+	}
+	if profiles[1].Instructions != nil {
+		t.Fatalf("absent instructions = %#v", profiles[1].Instructions)
+	}
+	if len(cfg.Managed.Executors) != 1 || len(cfg.Managed.Executors[0].Profiles) != 1 || cfg.Managed.Executors[0].Profiles[0].PrepareScript != "default" {
+		t.Fatalf("managed executors = %#v", cfg.Managed.Executors)
+	}
+	if len(cfg.Managed.Workspaces) != 1 {
+		t.Fatalf("managed workspaces = %#v", cfg.Managed.Workspaces)
+	}
+	github := cfg.Managed.Workspaces[0].GitHub
+	if github == nil || github.TaskCredentialsMode != "executor" || github.RepositoryScopeMode != "all" {
+		t.Fatalf("managed GitHub configuration = %#v", github)
+	}
+}
