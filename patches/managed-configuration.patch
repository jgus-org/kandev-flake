+func (s *Service) SetRepositoryBranchDefaults(workspaceID, prefix, template string) error {
+	prefix = strings.TrimSpace(prefix)
+	if err := worktree.ValidateBranchPrefix(prefix); err != nil {
+		return fmt.Errorf("invalid repository branch prefix: %w", err)
+	}
+	template = worktree.NormalizeBranchNameTemplate(template)
+	if err := worktree.ValidateBranchNameTemplate(template); err != nil {
+		return fmt.Errorf("invalid repository branch template: %w", err)
+	}
+	s.repositoryBranchDefaultsMu.Lock()
+	s.repositoryBranchDefaults[workspaceID] = repositoryBranchDefaults{prefix: prefix, template: template}
+	s.repositoryBranchDefaultsMu.Unlock()
+	return nil
+}
+
+func (s *Service) repositoryBranchDefaultsFor(workspaceID string) (repositoryBranchDefaults, bool) {
+	s.repositoryBranchDefaultsMu.RLock()
+	defaults, ok := s.repositoryBranchDefaults[workspaceID]
+	s.repositoryBranchDefaultsMu.RUnlock()
+	return defaults, ok
+}
