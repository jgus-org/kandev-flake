+package backendapp
+
+import (
+	"context"
+	"testing"
+)
+
+type recordingManagedInstructionStore struct {
+	files map[string]map[string]string
+	calls int
+}
+
+func (s *recordingManagedInstructionStore) UpsertInstruction(
+	_ context.Context, profileID, filename, content string, isEntry bool,
+) error {
+	if filename != "AGENTS.md" || !isEntry {
+		panic("managed instructions must only upsert the entry AGENTS.md")
+	}
+	if s.files[profileID] == nil {
+		s.files[profileID] = make(map[string]string)
+	}
+	s.files[profileID][filename] = content
+	s.calls++
+	return nil
+}
+
+func TestReconcileManagedProfileInstructions(t *testing.T) {
+	ctx := context.Background()
+	store := &recordingManagedInstructionStore{files: map[string]map[string]string{
+		"codex":    {"AGENTS.md": "old", "HEARTBEAT.md": "keep"},
+		"opencode": {"AGENTS.md": "other"},
+	}}
+
+	managed := "new"
+	if err := reconcileManagedProfileInstructions(ctx, store, "new-profile", &managed); err != nil {
+		t.Fatal(err)
+	}
+	if got := store.files["new-profile"]["AGENTS.md"]; got != "new" {
+		t.Fatalf("new managed AGENTS.md = %q", got)
+	}
+	if err := reconcileManagedProfileInstructions(ctx, store, "codex", &managed); err != nil {
+		t.Fatal(err)
+	}
+	if err := reconcileManagedProfileInstructions(ctx, store, "codex", &managed); err != nil {
+		t.Fatal(err)
+	}
+	if got := store.files["codex"]["AGENTS.md"]; got != "new" {
+		t.Fatalf("managed AGENTS.md = %q", got)
+	}
+	if got := store.files["codex"]["HEARTBEAT.md"]; got != "keep" {
+		t.Fatalf("unmanaged sibling = %q", got)
+	}
+	if got := store.files["opencode"]["AGENTS.md"]; got != "other" {
+		t.Fatalf("other profile AGENTS.md = %q", got)
+	}
+
+	empty := ""
+	if err := reconcileManagedProfileInstructions(ctx, store, "codex", &empty); err != nil {
+		t.Fatal(err)
+	}
+	if got := store.files["codex"]["AGENTS.md"]; got != "" {
+		t.Fatalf("explicit empty AGENTS.md = %q", got)
+	}
+
+	calls := store.calls
+	if err := reconcileManagedProfileInstructions(ctx, store, "codex", nil); err != nil {
+		t.Fatal(err)
+	}
+	if store.calls != calls {
+		t.Fatal("absent instructions changed stored files")
+	}
+}
