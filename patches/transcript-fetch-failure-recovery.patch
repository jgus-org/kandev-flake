+// Spies shared across sequential fetches so a test can watch what a rejected
+// fetch does to state an earlier fetch established.
+function makeObservedParams(
+  fetchAndStoreMessages: (
+    sessionId: string,
+    store: never,
+    isActive?: () => boolean,
+  ) => Promise<Message[]>,
+) {
+  const setMessages = vi.fn();
+  const setMessagesLoading = vi.fn();
+  const lastFetchedSessionIdRef = { current: null as string | null };
+  return {
+    setMessages,
+    lastFetchedSessionIdRef,
+    params: {
+      taskSessionId: SESSION_ID,
+      store: { getState: () => ({ setMessagesLoading, setMessages }) } as never,
+      setIsLoading: vi.fn(),
+      setIsWaitingForInitialMessages: vi.fn(),
+      initialFetchStartRef: { current: null },
+      lastFetchedSessionIdRef,
+      fetchAndStoreMessages,
+    },
+  };
+}
