+// A terminal session will never gain an execution, so its shell handshake must
+// answer Gone rather than "retry later" — the 503 is what drove an open browser
+// tab to reconnect every few seconds forever.
+func TestHandleTerminalWSEnvironmentRouteGoneForTerminalSession(t *testing.T) {
+	log, _ := observedTerminalLogger(t)
+	handler, manager := newBridgeTestHandler(t, log)
+	manager.SetEnvironmentAccessChecker(func(context.Context, string) error {
+		return fmt.Errorf("verify session before registering execution: session %q is CANCELLED: %w", "session-1", lifecycle.ErrSessionTerminal)
+	})
+	c, recorder := terminalContext(t, "/environment/env-1", "?terminalId=t-1")
+
+	handler.HandleTerminalWS(c)
+
+	if recorder.Code != http.StatusGone {
+		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusGone)
+	}
+	var body map[string]string
+	if err := json.Unmarshal(recorder.Body.Bytes(), &body); err != nil {
+		t.Fatalf("decode response: %v", err)
+	}
+	if body["reason"] != terminalReasonSessionEnded {
+		t.Fatalf("reason = %q, want %q", body["reason"], terminalReasonSessionEnded)
+	}
+}
+
+// A plain GET (no Upgrade header) against a ready environment is a reconnect
+// probe: it reports readiness as JSON without starting a shell or upgrading.
+func TestHandleTerminalWSEnvironmentProbeReportsReadyWithoutStartingAShell(t *testing.T) {
+	log, _ := observedTerminalLogger(t)
+	handler, manager := newBridgeTestHandler(t, log)
+	if err := manager.ExecutionStoreForTesting().Add(&lifecycle.AgentExecution{
+		ID:                "exec-1",
+		SessionID:         "session-1",
+		TaskEnvironmentID: "env-1",
+	}); err != nil {
+		t.Fatalf("seed execution: %v", err)
+	}
+	c, recorder := terminalContext(t, "/environment/env-1", "?terminalId=t-1")
+
+	handler.HandleTerminalWS(c)
+
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("status = %d, want %d", recorder.Code, http.StatusOK)
+	}
+	var body map[string]any
+	if err := json.Unmarshal(recorder.Body.Bytes(), &body); err != nil {
+		t.Fatalf("decode response: %v", err)
+	}
+	if body["ready"] != true {
+		t.Fatalf("ready = %v, want true", body["ready"])
+	}
+}
