+// respondShellTerminalReadiness maps a shell-terminal execution-readiness error to
+// the HTTP status returned before any WebSocket upgrade. A terminal session will
+// never gain an execution, so it is Gone: a permanent answer the client must stop
+// retrying on (503 would tell it to "retry later", which it does forever). Every
+// other failure — the workspace is still being prepared, a transient startup race —
+// stays Service Unavailable so normal terminal startup is unaffected.
+func (h *TerminalHandler) respondShellTerminalReadiness(c *gin.Context, err error, environmentID, terminalID string) {
+	if errors.Is(err, lifecycle.ErrSessionTerminal) {
+		h.logger.Info("environment terminal session is terminal",
+			zap.String("task_environment_id", environmentID),
+			zap.String("terminal_id", terminalID),
+			zap.Error(err))
+		c.JSON(http.StatusGone, gin.H{"error": err.Error(), "reason": terminalReasonSessionEnded})
+		return
+	}
+	h.logger.Warn("environment terminal execution not ready",
+		zap.String("task_environment_id", environmentID),
+		zap.String("terminal_id", terminalID),
+		zap.Error(err))
+	c.JSON(http.StatusServiceUnavailable, gin.H{"error": err.Error()})
+}
