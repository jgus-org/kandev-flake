diff --git a/apps/backend/internal/agent/agents/qwen_acp_test.go b/apps/backend/internal/agent/agents/qwen_acp_test.go
new file mode 100644
--- /dev/null
+++ b/apps/backend/internal/agent/agents/qwen_acp_test.go
@@ -0,0 +1,37 @@
+package agents
+
+import (
+	"slices"
+	"testing"
+)
+
+func TestQwenACPExecutableOverride(t *testing.T) {
+	for _, tt := range []struct {
+		name       string
+		executable string
+		command    []string
+	}{
+		{name: "default", command: []string{"npx", "-y", qwenACPPkg}},
+		{name: "override", executable: "/opt/qwen code/bin/qwen", command: []string{"/opt/qwen code/bin/qwen"}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv("QWEN_CODE_PATH", tt.executable)
+			a := NewQwenACP()
+			acp := append(slices.Clone(tt.command), "--acp")
+			for name, command := range map[string]Command{
+				"launch":    a.BuildCommand(CommandOptions{}),
+				"runtime":   a.Runtime().Cmd,
+				"inference": a.InferenceConfig().Command,
+			} {
+				if got := command.Args(); !slices.Equal(got, acp) {
+					t.Errorf("%s = %q, want %q", name, got, acp)
+				}
+			}
+			passthrough := a.BuildPassthroughCommand(PassthroughOptions{Model: "local-model"}).Args()
+			want := append(slices.Clone(tt.command), "--model", "local-model")
+			if !slices.Equal(passthrough, want) {
+				t.Errorf("passthrough = %q, want %q", passthrough, want)
+			}
+		})
+	}
+}
