diff --git a/apps/backend/internal/agent/runtime/lifecycle/session_git_directories_test.go b/apps/backend/internal/agent/runtime/lifecycle/session_git_directories_test.go
new file mode 100644
index 0000000..f3fabfb
--- /dev/null
+++ b/apps/backend/internal/agent/runtime/lifecycle/session_git_directories_test.go
@@ -0,0 +1,47 @@
+package lifecycle
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+func TestWorkspaceGitAdditionalDirectoriesUsesLinkedWorktreeCommonDir(t *testing.T) {
+	repository := t.TempDir()
+	runGitDirectoryTest(t, repository, "init", "--initial-branch=main")
+	runGitDirectoryTest(t, repository, "config", "user.name", "Test")
+	runGitDirectoryTest(t, repository, "config", "user.email", "test@example.invalid")
+	if err := os.WriteFile(filepath.Join(repository, "file"), []byte("base"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	runGitDirectoryTest(t, repository, "add", "file")
+	runGitDirectoryTest(t, repository, "commit", "-m", "base")
+	worktree := filepath.Join(t.TempDir(), "worktree")
+	runGitDirectoryTest(t, repository, "worktree", "add", "-b", "agent/test", worktree)
+
+	directories := workspaceGitAdditionalDirectories(worktree)
+	want, err := filepath.EvalSymlinks(filepath.Join(repository, ".git"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	wantGitDir, err := filepath.EvalSymlinks(filepath.Join(want, "worktrees", filepath.Base(worktree)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(directories) != 2 || directories[0] != wantGitDir || directories[1] != want {
+		t.Fatalf("additional directories = %#v, want [%q %q]", directories, wantGitDir, want)
+	}
+	if directories := workspaceGitAdditionalDirectories(repository); len(directories) != 0 {
+		t.Fatalf("standalone repository directories = %#v", directories)
+	}
+}
+
+func runGitDirectoryTest(t *testing.T, directory string, args ...string) {
+	t.Helper()
+	command := exec.Command("git", args...)
+	command.Dir = directory
+	if output, err := command.CombinedOutput(); err != nil {
+		t.Fatalf("git %v: %v: %s", args, err, output)
+	}
+}
