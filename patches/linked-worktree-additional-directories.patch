+func workspaceGitAdditionalDirectories(workspacePath string) []string {
+	gitDir, err := gitref.ResolveGitDir(workspacePath)
+	if err != nil {
+		return nil
+	}
+	commonDir := gitref.ResolveCommonGitDir(gitDir)
+	workspacePath, err = filepath.EvalSymlinks(workspacePath)
+	if err != nil {
+		return nil
+	}
+	gitDir, err = filepath.EvalSymlinks(gitDir)
+	if err != nil {
+		return nil
+	}
+	commonDir, err = filepath.EvalSymlinks(commonDir)
+	if err != nil {
+		return nil
+	}
+	relative, err := filepath.Rel(workspacePath, commonDir)
+	if err != nil || (relative != ".." && !strings.HasPrefix(relative, ".."+string(filepath.Separator))) {
+		return nil
+	}
+	return []string{gitDir, commonDir}
+}
